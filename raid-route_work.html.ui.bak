<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Raid Route — Tarkov quest route planner</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Barlow:wght@400;500;600&display=swap">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.js"></script>
<style>
:root{
  --bg:#141a19; --panel:#1b2423; --panel2:#222d2b; --line:#304140;
  --text:#e9e4d4; --mute:#93a49e; --accent:#ffb23e; --ink:#1c1405;
  --ok:#7fcf9a; --bad:#e8765e;
  --f-head:'Barlow Condensed','Arial Narrow',Arial,sans-serif;
  --f-body:'Barlow','Segoe UI',system-ui,sans-serif;
}
*{box-sizing:border-box}
html,body{margin:0;height:100%;background:var(--bg);color:var(--text);font:15px/1.45 var(--f-body)}
button,input,textarea{font:inherit;color:inherit}
button{background:var(--panel2);border:1px solid var(--line);border-radius:5px;padding:6px 11px;cursor:pointer}
button:hover{border-color:var(--accent)}
button:focus-visible,input:focus-visible,textarea:focus-visible,summary:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
button.primary{background:var(--accent);color:var(--ink);border-color:var(--accent);font-weight:600}
button.quiet{background:none;border-color:transparent;color:var(--mute);padding:2px 7px}
button.quiet:hover{color:var(--text);border-color:var(--line)}

#app{display:grid;grid-template-columns:330px minmax(0,1fr) 350px;grid-template-rows:auto minmax(0,1fr);height:100vh}
header{grid-column:1/-1;display:flex;align-items:center;gap:18px;padding:8px 14px;background:var(--panel);border-bottom:1px solid var(--line)}
header h1{margin:0;font:700 24px/1 var(--f-head);letter-spacing:.02em;white-space:nowrap}
#tabs{display:flex;gap:4px;flex:1;min-width:0;overflow-x:auto;padding:2px}
#tabs button{display:flex;flex-direction:column;align-items:flex-start;padding:4px 11px;min-width:max-content;line-height:1.15}
#tabs button b{font:600 16px var(--f-head);letter-spacing:.02em}
#tabs button small{color:var(--mute);font-size:12px}
#tabs button.cur{background:var(--accent);border-color:var(--accent);color:var(--ink)}
#tabs button.cur small{color:#4b3a12}
#tabs button.dim{opacity:.5}
#tabs button.best:not(.cur){border-color:var(--accent)}
.hdr-r{display:flex;gap:8px;align-items:center}
.seg{display:flex}
.seg button{border-radius:0}
.seg button:first-child{border-radius:5px 0 0 5px}
.seg button:last-child{border-radius:0 5px 5px 0;margin-left:-1px}
.seg button.on{background:var(--accent);color:var(--ink);border-color:var(--accent);font-weight:600}

aside{background:var(--panel);overflow-y:auto;min-height:0}
#left{border-right:1px solid var(--line)}
#right{border-left:1px solid var(--line)}
section.blk{padding:12px 14px;border-bottom:1px solid var(--line)}
section.blk h2{margin:0 0 8px;font:600 18px var(--f-head);letter-spacing:.02em}
label.lbl{display:block;font:600 17px var(--f-head);margin-bottom:6px;letter-spacing:.02em}
.combo{position:relative}
.combo input{width:100%;background:var(--bg);border:1px solid var(--line);border-radius:5px;padding:8px 10px}
#sugg{position:absolute;left:0;right:0;top:100%;z-index:900;margin:2px 0 0;padding:0;list-style:none;background:var(--panel2);border:1px solid var(--accent);border-radius:5px;max-height:300px;overflow-y:auto}
#sugg li{padding:6px 10px;cursor:pointer;display:flex;justify-content:space-between;gap:10px}
#sugg li.sel,#sugg li:hover{background:#2c3a38}
#sugg li small{color:var(--mute);white-space:nowrap}
.row{display:flex;gap:8px;margin-top:8px;flex-wrap:wrap}
.muted{color:var(--mute);font-size:13px}

.qcard{border-bottom:1px solid var(--line)}
.qcard summary{list-style:none;display:flex;align-items:center;gap:8px;padding:8px 14px;cursor:pointer}
.qcard summary::-webkit-details-marker{display:none}
.swatch{width:12px;height:12px;border-radius:3px;flex:none}
.qname{flex:1;min-width:0;font-weight:500}
.qname small{display:block;color:var(--mute);font-weight:400;font-size:12px}
.qcard .objs{padding:0 14px 10px 34px}
.obj{display:flex;gap:7px;align-items:flex-start;padding:3px 0;font-size:13px;line-height:1.35}
.obj input{margin-top:3px}
.obj.done span.t{text-decoration:line-through;color:var(--mute)}
.tag{display:inline-block;font-size:11px;border:1px solid var(--line);border-radius:3px;padding:0 4px;color:var(--mute);margin-left:4px;white-space:nowrap}
.tag.opt{border-color:#6a5a2e;color:#d4b25f}

#center{position:relative;min-width:0;min-height:0;display:flex;flex-direction:column}
#mapwrap{position:relative;flex:1;min-height:0}
#map{position:absolute;inset:0;background:#0d1211}
.leaflet-container{background:#0d1211;font-family:var(--f-body)}
.maptools{position:absolute;z-index:700;display:flex;flex-direction:column;gap:6px;pointer-events:none}
.maptools>*{pointer-events:auto}
#floors{left:56px;top:10px;flex-direction:row;flex-wrap:wrap;max-width:60%}
#floors button{padding:3px 9px;background:#0d1211cc;font-size:13px}
#floors button.on{background:var(--accent);color:var(--ink);border-color:var(--accent);font-weight:600}
#viewtools{right:10px;top:10px;align-items:flex-end}
.pill{background:#0d1211dd;border:1px solid var(--line);border-radius:6px;padding:6px 10px;font-size:13px}
.pill label{display:flex;gap:6px;align-items:center;cursor:pointer}
details.align{background:#0d1211ee;border:1px solid var(--line);border-radius:6px;font-size:13px;max-width:290px}
details.align summary{padding:6px 10px;cursor:pointer}
details.align div{padding:2px 10px 10px}
details.align .row{margin-top:6px}
#mapmsg{position:absolute;inset:0;z-index:800;display:none;align-items:center;justify-content:center;text-align:center;padding:30px;background:#0d1211ee}
#mapmsg.show{display:flex}
#mapmsg p{max-width:460px}
#credit{position:absolute;left:56px;bottom:8px;z-index:700;font-size:11px;color:var(--mute);background:#0d1211cc;padding:2px 7px;border-radius:4px}
#credit a{color:var(--mute)}

.stop{background:none;border:0}
.stop span{display:grid;place-items:center;width:28px;height:28px;border-radius:50%;background:var(--accent);color:var(--ink);font:700 16px/1 var(--f-head);border:2px solid var(--ink);box-shadow:0 0 0 2px var(--accent),0 2px 6px #000a}
.ext{background:none;border:0}
.ext span{display:block;width:13px;height:13px;transform:rotate(45deg);border:2px solid #fff;box-shadow:0 0 0 1px #000}
.ext.pmc span{background:#58c47a}.ext.scav span{background:#5ba3e0}.ext.shared span{background:#e0a24a}
.route-line{animation:flow 1.6s linear infinite}
@keyframes flow{to{stroke-dashoffset:-32}}
@media (prefers-reduced-motion:reduce){.route-line{animation:none}}
.pop b{display:block;margin-bottom:2px}
.pop .pi{margin:5px 0;font-size:13px}
.pop .pi button{margin-top:3px;padding:2px 8px;font-size:12px;color:#222;background:#eee;border-color:#bbb}
.leaflet-popup-content{margin:10px 12px;color:#1c2321}

.best-card{margin:12px 14px;padding:10px 12px;border:1px solid var(--accent);border-radius:6px;background:#2a2515}
.best-card b{font:600 18px var(--f-head);letter-spacing:.02em}
.steps{list-style:none;margin:0;padding:0}
.steps li{display:flex;gap:10px;padding:8px 14px;border-bottom:1px solid var(--line);cursor:pointer}
.steps li:hover{background:var(--panel2)}
.steps .n{flex:none;width:26px;height:26px;border-radius:50%;background:var(--accent);color:var(--ink);display:grid;place-items:center;font:700 15px var(--f-head)}
.steps .n.x{background:none;border:2px solid var(--mute);color:var(--mute)}
.steps .it{font-size:13px;line-height:1.35;margin-bottom:3px}
.steps .it i{font-style:normal;font-weight:600}
.steps .d{color:var(--mute);font-size:12px}
.statline{display:flex;gap:16px;flex-wrap:wrap;padding:10px 14px;border-bottom:1px solid var(--line)}
.statline div b{display:block;font:700 22px/1.1 var(--f-head)}
.statline div span{color:var(--mute);font-size:12px}
.listbox{padding:8px 14px;font-size:13px;border-bottom:1px solid var(--line)}
.listbox h3{margin:0 0 4px;font:600 16px var(--f-head);letter-spacing:.02em}
.listbox div{margin:3px 0}
.empty{padding:22px 16px;color:var(--mute)}
.empty b{display:block;color:var(--text);font:600 18px var(--f-head);margin-bottom:4px}

#overlay{position:fixed;inset:0;z-index:5000;background:var(--bg);display:flex;align-items:center;justify-content:center;flex-direction:column;gap:12px;text-align:center;padding:30px}
#overlay.hide{display:none}
#overlay h2{margin:0;font:700 34px var(--f-head)}
#overlay .err{color:var(--bad);max-width:560px;white-space:pre-wrap;font-size:14px}
dialog{background:var(--panel);color:var(--text);border:1px solid var(--accent);border-radius:8px;padding:16px;width:min(520px,92vw)}
dialog::backdrop{background:#000a}
dialog textarea{width:100%;height:200px;background:var(--bg);border:1px solid var(--line);border-radius:5px;padding:8px;resize:vertical}
dialog h2{margin:0 0 6px;font:700 22px var(--f-head)}

@media (max-width:1050px){
  body{height:auto}
  #app{display:flex;flex-direction:column;height:auto}
  #center{order:2;height:68vh;flex:none}
  #left{order:3;border:0}
  #right{order:1;border:0;max-height:none}
  header{flex-wrap:wrap}
  #tabs{order:3;flex-basis:100%}
}

#prepBtn{white-space:nowrap}
#prepDlg{width:min(700px,94vw)}
#prepDlg[open]{display:flex;flex-direction:column;max-height:88vh}
.prep-h{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:6px}
.prep-h h2{margin:0}
#prepBody{overflow-y:auto;min-height:0;flex:1;margin:8px 0;padding-right:4px}
#prepBody h3{margin:14px 0 4px;font:600 18px var(--f-head);letter-spacing:.02em;color:var(--accent)}
#prepBody h3:first-child{margin-top:0}
label.pr{display:flex;gap:9px;align-items:flex-start;padding:6px 4px;border-bottom:1px solid var(--line);cursor:pointer}
label.pr:hover{background:var(--panel2)}
label.pr input{margin-top:4px}
label.pr b{font-weight:600;margin-right:6px}
label.pr small{display:block;color:var(--mute);font-size:12px;margin-top:1px}
label.pr.on span{color:var(--mute);text-decoration:line-through}
.fir{display:inline-block;font-size:11px;border:1px solid #6a5a2e;color:#d4b25f;border-radius:3px;padding:0 4px;margin-left:5px}

.av{position:relative;display:inline-grid;place-items:center;width:var(--s,24px);height:var(--s,24px);border-radius:50%;background:var(--panel2);border:1px solid var(--line);font-weight:600;font-size:calc(var(--s,24px)*.42);font-family:var(--f-head);color:var(--mute);overflow:hidden;flex:none;vertical-align:middle;text-transform:uppercase}
.av img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
#sugg li small.tr{display:flex;align-items:center;gap:6px}
.qname small.tr .av{margin-right:5px}
#traderBar{margin-top:10px}
.tchips{display:flex;flex-wrap:wrap;gap:6px}
.tchip{display:flex;flex-direction:column;align-items:center;gap:2px;width:58px;padding:5px 2px 4px;background:var(--panel2)}
.tchip small{font-size:11px;color:var(--mute);max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.tchip.on{border-color:var(--accent);background:#2a2515}
.tchip.on small{color:var(--text)}
.tchip.on .av{border-color:var(--accent)}
.tlist-h{display:flex;align-items:baseline;gap:8px;margin:10px 0 4px}
.tlist-h .muted{flex:1}
#traderList{max-height:280px;overflow-y:auto;border:1px solid var(--line);border-radius:5px}
.trow{display:flex;gap:8px;align-items:center;width:100%;text-align:left;border:0;border-bottom:1px solid var(--line);border-radius:0;background:none;padding:6px 8px}
.trow:hover:not(:disabled){background:var(--panel2)}
.trow .lv{flex:none;width:42px;color:var(--mute);font-size:12px}
.trow .tn{flex:1;min-width:0}
.trow .ta{flex:none;font-size:12px;color:var(--accent)}
.trow.added{opacity:.5;cursor:default}
.trow.added .ta{color:var(--ok)}
</style>
</head>
<body>
<div id="app">
  <header>
    <h1>Raid Route</h1>
    <nav id="tabs" aria-label="Maps"></nav>
    <div class="hdr-r">
      <button id="prepBtn" class="primary" title="Keys, items and gear needed for your selected quests">Pre-raid check</button>
      <div class="seg" id="modeSeg" role="group" aria-label="Game mode">
        <button data-m="regular">PvP</button><button data-m="pve">PvE</button>
      </div>
      <button id="refresh" title="Re-download quests, extracts and map calibration">Refresh data</button>
    </div>
  </header>

  <aside id="left">
    <section class="blk">
      <label class="lbl" for="q">Active quests</label>
      <div class="combo">
        <input id="q" autocomplete="off" placeholder="Type a quest name, press Enter to add">
        <ul id="sugg" hidden></ul>
      </div>
      <div class="row">
        <button id="bulk">Paste a list</button>
        <button id="clearAll" class="quiet">Remove all</button>
        <label class="muted" style="margin-left:auto;display:flex;gap:5px;align-items:center"><input type="checkbox" id="optOptional"> include optional objectives</label>
      </div>
    </section>
    <div id="quests"></div>
  </aside>

  <main id="center">
    <div id="mapwrap">
      <div id="map"></div>
      <div class="maptools" id="floors"></div>
      <div class="maptools" id="viewtools">
        <div class="pill">
          <label><input type="checkbox" id="optExt"> Extracts</label>
          <label style="margin-top:4px"><span class="muted">Spawn as</span>
            <select id="optFac" style="background:var(--bg);color:var(--text);border:1px solid var(--line);border-radius:4px"><option value="pmc">PMC</option><option value="scav">Scav</option></select>
          </label>
        </div>
        <button id="fit" class="pill" style="cursor:pointer">Zoom to route</button>
        <details class="align">
          <summary>Map alignment</summary>
          <div>
            <p class="muted" style="margin:6px 0 0">Green/blue/orange extract diamonds should sit on the extract symbols drawn in the map. If they don't, rotate or mirror until they do. Your fix is saved for this map.</p>
            <div class="row">
              <button id="alRot">Rotate 90°</button>
              <button id="alMir">Mirror</button>
              <button id="alSwap">Swap bounds axes</button>
              <button id="alReset" class="quiet">Reset</button>
            </div>
            <p class="muted" id="alInfo" style="margin:8px 0 0"></p>
          </div>
        </details>
      </div>
      <div id="mapmsg"><p></p></div>
      <div id="credit">Map art: <a href="https://github.com/the-hideout/tarkov-dev-svg-maps" target="_blank" rel="noopener">tarkov.dev SVG maps</a> (CC BY-NC-SA 4.0) · Data: <a href="https://tarkov.dev" target="_blank" rel="noopener">tarkov.dev</a></div>
    </div>
  </main>

  <aside id="right">
    <div id="route"></div>
  </aside>
</div>

<dialog id="bulkDlg">
  <h2>Paste your quest list</h2>
  <p class="muted" style="margin:0 0 8px">One quest name per line. Close matches are accepted; anything that can't be matched is listed so you can fix it.</p>
  <textarea id="bulkTxt" placeholder="Debut&#10;Shootout Picnic&#10;Punisher - Part 1"></textarea>
  <p id="bulkOut" class="muted"></p>
  <div class="row" style="justify-content:flex-end">
    <button id="bulkCancel">Close</button>
    <button id="bulkGo" class="primary">Add quests</button>
  </div>
</dialog>

<dialog id="prepDlg">
  <div class="prep-h"><h2>Pre-raid check</h2>
    <div class="seg" id="prepScopeSeg" role="group" aria-label="Scope"><button data-s="map">This map</button><button data-s="all">All my quests</button></div>
  </div>
  <p class="muted" id="prepSub" style="margin:0"></p>
  <div id="prepBody"></div>
  <div class="row" style="justify-content:space-between;margin-top:0">
    <button id="prepReset" class="quiet">Clear all ticks</button>
    <button id="prepClose" class="primary">Close</button>
  </div>
</dialog>

<div id="overlay"><h2>Raid Route</h2><div id="ovtext" class="muted">Loading…</div><div class="muted" style="font-size:11px">build r4</div></div>

<script>
'use strict';
/* ============ constants ============ */
const BUILD = 'r4-get-first';
const API = '/graphql';
console.log('Raid Route build', BUILD);
const MAPS_JSON = 'https://raw.githubusercontent.com/the-hideout/tarkov-dev/main/src/data/maps.json';
const SVG_BASE = 'https://raw.githubusercontent.com/the-hideout/tarkov-dev-svg-maps/main/';
const SVG_FILES = {
  'customs':'Customs','woods':'Woods','shoreline':'Shoreline','interchange':'Interchange','reserve':'Reserve',
  'lighthouse':'Lighthouse','streets-of-tarkov':'StreetsOfTarkov','factory':'Factory','the-lab':'Labs','ground-zero':'GroundZero'
};
const MAP_LABEL = {
  'customs':'Customs','woods':'Woods','shoreline':'Shoreline','interchange':'Interchange','reserve':'Reserve',
  'lighthouse':'Lighthouse','streets-of-tarkov':'Streets','factory':'Factory','the-lab':'Labs','ground-zero':'Ground Zero'
};
const MAPS = Object.keys(SVG_FILES);
const NONMAP = new Set(['giveItem','giveQuestItem','taskStatus','traderLevel','playerLevel','skill','experience','buildWeapon','sellItem','traderStanding']);
const COLORS = ['#e4572e','#29a8ab','#a07be0','#7bc043','#f4d35e','#ee6c9a','#4f9df0','#f19143','#9fd8cb','#c9a66b'];
const STALE_MS = 12*3600e3;

/* ============ helpers ============ */
const $ = s => document.querySelector(s);
const esc = s => String(s ?? '').replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const LS = {
  get(k,d){ try{ const v = localStorage.getItem(k); return v==null ? d : JSON.parse(v); }catch(e){ return d; } },
  set(k,v){ try{ localStorage.setItem(k, JSON.stringify(v)); }catch(e){} }
};
const canon = n => !n ? null : n.includes('factory') ? 'factory' : n.startsWith('ground-zero') ? 'ground-zero' : n;
const dist = (a,b) => Math.hypot(a.x-b.x, a.z-b.z);
const cent = pts => ({ x: pts.reduce((s,p)=>s+p.x,0)/pts.length, y: pts.reduce((s,p)=>s+(p.y||0),0)/pts.length, z: pts.reduce((s,p)=>s+p.z,0)/pts.length });
const norm = s => String(s).toLowerCase().replace(/[^a-z0-9 ]/g,' ').replace(/\s+/g,' ').trim();

/* ============ state ============ */
const S = {
  mode: LS.get('rr_mode','regular'),
  tasks: [], byId: new Map(), extracts: {}, cal: {},
  active: new Set(LS.get('rr_active',[])),
  done: new Set(LS.get('rr_done',[])),
  curMap: LS.get('rr_map', null),
  align: LS.get('rr_align', {}),
  opts: Object.assign({ extracts:true, faction:'pmc', optional:false }, LS.get('rr_opts',{})),
  map: null, layer: null, svgCache: {}, an: null, fitZoom: 0, stamp: 0
};
const saveActive = () => { LS.set('rr_active',[...S.active]); LS.set('rr_done',[...S.done]); };
const saveOpts = () => LS.set('rr_opts', S.opts);

/* ============ GraphQL with self-healing queries ============ */
const ZONE = 'zones { id map { normalizedName } position { x y z } outline { x y z } top bottom }';
const TASKS_Q = `query($gm: GameMode) { tasks(gameMode: $gm) { id name minPlayerLevel kappaRequired trader { name } map { normalizedName }
 objectives { id type description optional maps { normalizedName }
  ... on TaskObjectiveBasic { ${ZONE} }
  ... on TaskObjectiveItem { count foundInRaid item { name } ${ZONE} }
  ... on TaskObjectiveMark { markerItem { name } ${ZONE} }
  ... on TaskObjectiveQuestItem { count questItem { name } possibleLocations { map { normalizedName } positions { x y z } } ${ZONE} }
  ... on TaskObjectiveShoot { count targetNames ${ZONE} }
  ... on TaskObjectiveUseItem { count ${ZONE} }
  ... on TaskObjectiveExtract { exitName }
 } } }`;

/* Build the tasks query from the live schema so we never ask for a field the API lacks */
const tname = t => { while(t && !t.name) t = t.ofType; return t && t.name; };
async function introspect(){
  const names = ['Task','TaskZone','TaskObjectiveBasic','TaskObjectiveItem','TaskObjectiveMark','TaskObjectiveQuestItem','TaskObjectiveShoot','TaskObjectiveUseItem','TaskObjectiveExtract'];
  const TF = 'fields { name type { name ofType { name ofType { name ofType { name } } } } }';
  const q = '{ root:__type(name:"Query"){ fields { name args { name type { name ofType { name } } } } } ' +
    names.map(n => `${n}:__type(name:"${n}"){ ${TF} }`).join(' ') + ' }';
  try{
    const d = await runQuery(q, {});
    const sch = { types:{}, gm:null, pl:null };
    names.forEach(n => { sch.types[n] = d[n] ? new Set(d[n].fields.map(f => f.name)) : null; });
    const tf = d.root && d.root.fields.find(f => f.name === 'tasks');
    const a = tf && tf.args.find(x => x.name === 'gameMode');
    sch.gm = a ? tname(a.type) : null;
    const qi = d.TaskObjectiveQuestItem && d.TaskObjectiveQuestItem.fields.find(f => f.name === 'possibleLocations');
    if(qi){
      try{
        const t2 = await runQuery(`{ t:__type(name:"${tname(qi.type)}"){ fields { name } } }`, {});
        if(t2.t) sch.pl = new Set(t2.t.fields.map(f => f.name));
      }catch(e){}
    }
    return sch;
  }catch(e){ console.warn('schema introspection failed, using default query', e); return null; }
}
function buildTasksQuery(sch){
  const has = (t, f) => !sch || !sch.types[t] || sch.types[t].has(f);
  const sel = (t, list) => list.filter(f => has(t, f.split(/[ {]/)[0])).join(' ');
  const zone = (sch && !sch.types.TaskZone) ? '' :
    'zones { ' + sel('TaskZone', ['id','map { normalizedName }','position { x y z }','outline { x y z }','top','bottom']) + ' }';
  const frag = (t, fields, withZones) => {
    if(sch && !sch.types[t]) return '';
    const body = sel(t, fields) + (withZones && has(t,'zones') ? ' ' + zone : '');
    return body.trim() ? `... on ${t} { ${body} }` : '';
  };
  const plOK = !sch || !sch.pl || (sch.pl.has('map') && sch.pl.has('positions'));
  const pl = (has('TaskObjectiveQuestItem','possibleLocations') && plOK) ? 'possibleLocations { map { normalizedName } positions { x y z } }' : '';
  const gmVar = sch && sch.gm ? `($gm: ${sch.gm})` : (sch ? '' : '($gm: GameMode)');
  const gmArg = gmVar ? '(gameMode: $gm)' : '';
  return `query${gmVar} { tasks${gmArg} { id name ${sel('Task',['minPlayerLevel','kappaRequired','trader { name }','map { normalizedName }'])}
    objectives { id type description optional maps { normalizedName }
      ${frag('TaskObjectiveBasic',[],true)}
      ${frag('TaskObjectiveItem',['count','foundInRaid','item { name }'],true)}
      ${frag('TaskObjectiveMark',['markerItem { name }'],true)}
      ${frag('TaskObjectiveQuestItem',['count','questItem { name }'],true).replace(/ \}$/, ' ' + pl + ' }')}
      ${frag('TaskObjectiveShoot',['count','targetNames'],true)}
      ${frag('TaskObjectiveUseItem',['count'],true)}
      ${frag('TaskObjectiveExtract',['exitName'],false)}
    } } }`;
}
const MAPS_Q = '{ maps { normalizedName name extracts { name faction position { x y z } } } }';
const SCOPE = { TaskZone:'zones {', Task:'tasks(', Map:'maps {', Extract:'extracts {' };

function matchBrace(q, i){ let d = 0; for(let j=i;j<q.length;j++){ if(q[j]==='{') d++; else if(q[j]==='}'){ d--; if(d===0) return j; } } return q.length-1; }
function stripFragment(q, type){
  const i = q.indexOf('... on '+type+' {'); if(i<0) return q;
  const e = matchBrace(q, q.indexOf('{', i));
  return q.slice(0,i) + q.slice(e+1);
}
function stripField(q, type, field){
  let lo = 0, hi = q.length;
  const fi = q.indexOf('... on '+type+' {');
  if(fi >= 0){ lo = q.indexOf('{', fi); hi = matchBrace(q, lo); }
  else if(SCOPE[type]){ const si = q.indexOf(SCOPE[type]); if(si>=0){ lo = q.indexOf('{', si); hi = matchBrace(q, lo); } }
  const m = new RegExp('(?<=[\\s{])'+field+'(?=[\\s{}])').exec(q.slice(lo,hi));
  if(!m) return q;
  const s = lo + m.index; let e = s + field.length, j = e;
  while(/\s/.test(q[j])) j++;
  if(q[j]==='{') e = matchBrace(q, j) + 1;
  return q.slice(0,s) + q.slice(e);
}
async function runQuery(q, vars){
  for(let i=0;i<40;i++){
    let r;
    // GET first: it is a "simple" request, so the browser skips the CORS preflight that api.tarkov.dev rejects.
    const u = API + '?query=' + encodeURIComponent(q) + (vars && Object.keys(vars).length ? '&variables=' + encodeURIComponent(JSON.stringify(vars)) : '');
    try{ r = await fetch(u); }
    catch(e1){
      try{ r = await fetch(API, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ query:q, variables:vars }) }); }
      catch(e2){ throw new Error('The browser blocked the request to api.tarkov.dev (build '+BUILD+').\n\nCheck the Console (F12) for a line starting "Access to fetch". If you use an ad-blocker or privacy extension, turn it off for this page and try again.'); }
    }
    let j; try{ j = await r.json(); }catch(e){ throw new Error('tarkov.dev API returned an unreadable response (HTTP '+r.status+')'); }
    if(!j.errors) return j.data;
    let changed = false;
    for(const e of j.errors){
      const m = e.message || '';
      let mm;
      if((mm = /Cannot query field "(\w+)" on type "(\w+)"/.exec(m))){ const n = stripField(q, mm[2], mm[1]); if(n!==q){ q=n; changed=true; } }
      else if((mm = /Unknown type "(\w+)"/.exec(m)) || (mm = /can never be of type "(\w+)"/.exec(m))){ const n = stripFragment(q, mm[1]); if(n!==q){ q=n; changed=true; } }
    }
    if(!changed){ if(j.data) return j.data; throw new Error(j.errors.map(e=>e.message).join('; ')); }
  }
  throw new Error('The tarkov.dev query kept failing after automatic repairs.');
}

/* ============ data loading ============ */
function normalizeTasks(raw){
  return raw.map(t => {
    const tmap = canon(t.map && t.map.normalizedName);
    const objs = (t.objectives || []).map(o => {
      const pts = {}, polys = {};
      const add = (m, p) => {
        if(!m || !p || p.x == null || p.z == null) return;
        const arr = pts[m] = pts[m] || [];
        if(!arr.some(q => Math.abs(q.x-p.x)<0.5 && Math.abs(q.z-p.z)<0.5)) arr.push({ x:p.x, y:p.y||0, z:p.z });
      };
      const firstMap = canon(o.maps && o.maps[0] && o.maps[0].normalizedName) || tmap;
      (o.zones || []).forEach(z => {
        const m = canon(z.map && z.map.normalizedName) || firstMap; if(!m) return;
        if(z.position) add(m, z.position); else if(z.outline && z.outline.length) add(m, cent(z.outline));
        if(z.outline && z.outline.length > 2) (polys[m] = polys[m] || []).push(z.outline);
      });
      (o.possibleLocations || []).forEach(pl => (pl.positions || []).forEach(p => add(canon(pl.map && pl.map.normalizedName), p)));
      const maps = new Set((o.maps || []).map(m => canon(m.normalizedName)).filter(Boolean));
      Object.keys(pts).forEach(k => maps.add(k));
      const nonmap = NONMAP.has(o.type);
      if(!maps.size && !nonmap && tmap && o.type !== 'findItem') maps.add(tmap);
      let text = o.description || o.type;
      return { id:o.id, type:o.type, desc:text, optional:!!o.optional, pts, polys, maps, nonmap, flex: !maps.size && !nonmap, req:o.req || null };
    });
    return { id:t.id, name:t.name, trader:(t.trader && t.trader.name) || '', traderId:(t.trader && t.trader.id) || '', level:t.minPlayerLevel, kappa:!!t.kappaRequired, map:tmap, objs, keys:(t.keys || []).map(x => ({ map:canon(x.map), names:x.names })) };
  }).filter(t => t.name);
}
function normalizeExtracts(raw){
  const out = {};
  (raw || []).forEach(m => {
    const k = canon(m.normalizedName); if(!k || !SVG_FILES[k]) return;
    const arr = out[k] = out[k] || [];
    (m.extracts || []).forEach(e => {
      if(!e.position || e.position.x == null) return;
      const f = (e.faction || 'shared').toLowerCase();
      if(!arr.some(a => a.name === e.name && Math.abs(a.p.x-e.position.x)<1)) arr.push({ name:e.name, faction:f, p:{ x:e.position.x, y:e.position.y||0, z:e.position.z } });
    });
  });
  return out;
}
async function loadTasks(force){
  setOv('Loading local quest data…');
  const file = S.mode === 'pve' ? 'quest_data_pve.json' : 'quest_data.json';
  let data;
  try{
    const r = await fetch(file, { cache:'no-store' });
    if(!r.ok) throw new Error('HTTP '+r.status);
    data = await r.json();
  }catch(e){
    throw new Error('Could not load '+file+' ('+e.message+').\n\nPut it in the same folder as this HTML file and open the page through "python proxy.py" at http://localhost:8000/' + (S.mode === 'pve' ? '\n\nOnly PvP (regular) quest data has been built. Switch back to PvP.' : ''));
  }
  if(!data || !data.tasks || !data.tasks.length) throw new Error(file+' contains no quests.');
  S.tasks = normalizeTasks(data.tasks);
  S.extracts = normalizeExtracts(data.maps || []);
  S.traders = data.traders || [];
  S.stamp = Date.now();
}

async function loadCal(force){
  const c = LS.get('rr_cal', null);
  if(!force && c && Date.now() - c.t < 7*864e5){ S.cal = c.cal; return; }
  setOv('Downloading map calibration (tarkov.dev)…');
  let j;
  try{
    const r = await fetch(MAPS_JSON); if(!r.ok) throw new Error('HTTP '+r.status);
    j = await r.json();
  }catch(e){
    if(c){ S.cal = c.cal; return; }
    throw new Error('Could not download the map calibration file from GitHub ('+e.message+'). Check your connection and press Refresh data.');
  }
  const cal = {};
  (Array.isArray(j) ? j : Object.values(j)).forEach(g => {
    const k = canon(g.normalizedName || g.key); if(!k || !SVG_FILES[k] || cal[k]) return;
    const vs = g.maps || [g];
    const v = vs.find(x => x.projection === 'interactive' && x.transform) || vs.find(x => x.svgPath && x.transform) || vs.find(x => x.transform);
    if(!v) return;
    cal[k] = { transform:v.transform, rotation:v.coordinateRotation || 0, bounds:v.svgBounds || v.bounds, layer:v.svgLayer || null, svgPath:v.svgPath || null };
  });
  if(!Object.keys(cal).length) throw new Error('The calibration file had an unexpected format.');
  S.cal = cal; LS.set('rr_cal', { t:Date.now(), cal });
}

/* ============ routing ============ */
function solve(groups){
  if(!groups.length) return [];
  const nn = (g0, p0) => {
    const rem = groups.filter(g => g !== g0), seq = [{ g:g0, p:p0 }]; let cur = p0, len = 0;
    while(rem.length){
      let bi = 0, bp = null, bd = Infinity;
      rem.forEach((g,i) => g.pts.forEach(p => { const dd = dist(cur,p); if(dd < bd){ bd = dd; bi = i; bp = p; } }));
      seq.push({ g:rem[bi], p:bp }); len += bd; cur = bp; rem.splice(bi,1);
    }
    return { seq, len };
  };
  const cands = [];
  groups.forEach(g => g.pts.slice(0,8).forEach(p => cands.push(nn(g,p))));
  cands.sort((a,b) => a.len - b.len);
  let best = null, bestLen = Infinity;
  cands.slice(0,5).forEach(c => {
    const l = improve(c.seq);
    if(l < bestLen){ bestLen = l; best = c.seq; }
  });
  return best;
}
function seqLen(seq){ let s = 0; for(let i=1;i<seq.length;i++) s += dist(seq[i-1].p, seq[i].p); return s; }
function improve(seq){
  let cur = seqLen(seq), loops = 0, imp = true;
  while(imp && loops++ < 25){
    imp = false;
    for(let i=0;i<seq.length;i++) for(const p of seq[i].g.pts){
      if(p === seq[i].p) continue;
      const o = seq[i].p; seq[i].p = p; const n = seqLen(seq);
      if(n < cur - 1e-6){ cur = n; imp = true; } else seq[i].p = o;
    }
    for(let i=0;i<seq.length-1;i++) for(let j=i+1;j<seq.length;j++){
      const old = seq.slice(i, j+1);
      seq.splice(i, j-i+1, ...old.slice().reverse());
      const n = seqLen(seq);
      if(n < cur - 1e-6){ cur = n; imp = true; } else seq.splice(i, j-i+1, ...old);
    }
  }
  return cur;
}
function extractsFor(key){
  const ok = S.opts.faction === 'scav' ? ['scav','shared'] : ['pmc','shared'];
  return (S.extracts[key] || []).filter(e => ok.includes(e.faction));
}
function buildRoute(a){
  const seq = solve(a.groups);
  const stops = [];
  seq.forEach(s => {
    const last = stops[stops.length-1];
    if(last && dist(last.p, s.p) < 25) last.items.push(s); else stops.push({ p:s.p, items:[s] });
  });
  let len = 0; for(let i=1;i<stops.length;i++) len += dist(stops[i-1].p, stops[i].p);
  let exit = null;
  const ex = extractsFor(a.key);
  if(ex.length){
    const lp = stops[stops.length-1].p;
    exit = ex.map(e => ({ e, dist: dist(lp, e.p) })).sort((x,y) => x.dist - y.dist)[0];
  }
  return { stops, len, exit };
}
function analyze(){
  const act = [...S.active].map(id => S.byId.get(id)).filter(Boolean);
  const A = {};
  MAPS.forEach(k => A[k] = { key:k, groups:[], anywhere:[], full:new Set(), part:new Set(), score:0, route:null });
  const flex = [], turnin = [];
  act.forEach(t => {
    const objs = t.objs.filter(o => !S.done.has(o.id) && (S.opts.optional || !o.optional));
    const mo = objs.filter(o => o.maps.size);
    objs.filter(o => o.flex).forEach(o => flex.push({ t, o }));
    objs.filter(o => o.nonmap).forEach(o => turnin.push({ t, o }));
    MAPS.forEach(k => {
      let any = false, all = mo.length > 0;
      mo.forEach(o => {
        if(o.maps.has(k)){
          any = true;
          const p = o.pts[k];
          if(p && p.length) A[k].groups.push({ t, o, pts:p }); else A[k].anywhere.push({ t, o });
        } else all = false;
      });
      if(any) (all ? A[k].full : A[k].part).add(t.id);
    });
  });
  MAPS.forEach(k => {
    const a = A[k];
    a.score = a.full.size*100 + a.groups.length + a.anywhere.length*0.5;
    a.route = a.groups.length ? buildRoute(a) : null;
  });
  const ranked = MAPS.filter(k => A[k].score > 0).sort((x,y) => A[y].score - A[x].score);
  return { A, act, flex, turnin, ranked };
}

/* ============ colours ============ */
const qColor = t => COLORS[[...S.active].indexOf(t.id) % COLORS.length];

/* ============ left column: quests ============ */
function renderQuests0(){
  const box = $('#quests');
  const act = [...S.active].map(id => S.byId.get(id)).filter(Boolean);
  if(!act.length){
    box.innerHTML = '<div class="empty"><b>No quests yet</b>Add the quests you have active right now. Each one gets a colour, and its objectives are pinned on the maps.</div>';
    return;
  }
  box.innerHTML = act.map(t => {
    const objs = t.objs.filter(o => S.opts.optional || !o.optional || S.done.has(o.id));
    const left = t.objs.filter(o => !S.done.has(o.id) && (S.opts.optional || !o.optional)).length;
    return `<details class="qcard" data-id="${esc(t.id)}">
      <summary><span class="swatch" style="background:${qColor(t)}"></span>
        <span class="qname">${esc(t.name)}<small class="tr">${avatarHTML(t.traderId || t.trader, 16)}${esc(t.trader)}${t.level ? ' · level '+t.level : ''} · ${left} objective${left===1?'':'s'} left</small></span>
        <button class="quiet rm" title="Remove quest" aria-label="Remove ${esc(t.name)}">✕</button></summary>
      <div class="objs">${objs.map(o => {
        const where = [...o.maps].map(m => MAP_LABEL[m] || m).join(', ');
        const pinned = Object.keys(o.pts).length;
        return `<label class="obj ${S.done.has(o.id)?'done':''}"><input type="checkbox" data-o="${esc(o.id)}" ${S.done.has(o.id)?'checked':''}>
          <span class="t">${esc(o.desc)}${where?`<span class="tag">${esc(where)}</span>`:''}${pinned?'':(o.nonmap?'<span class="tag">turn-in / other</span>':(where?'<span class="tag">no pin</span>':''))}${o.optional?'<span class="tag opt">optional</span>':''}</span></label>`;
      }).join('')}</div></details>`;
  }).join('');
  box.querySelectorAll('.qcard').forEach(card => {
    const id = card.dataset.id;
    card.querySelector('.rm').addEventListener('click', e => { e.preventDefault(); e.stopPropagation(); S.active.delete(id); saveActive(); refresh(); });
    card.querySelectorAll('input[data-o]').forEach(cb => cb.addEventListener('change', () => toggleDone(cb.dataset.o, cb.checked)));
  });
}
function toggleDone(oid, val){
  const v = val === undefined ? !S.done.has(oid) : val;
  if(v) S.done.add(oid); else S.done.delete(oid);
  saveActive();
  const open = [...document.querySelectorAll('.qcard[open]')].map(c => c.dataset.id);
  refresh();
  open.forEach(id => { const c = document.querySelector(`.qcard[data-id="${CSS.escape(id)}"]`); if(c) c.open = true; });
}

/* quest search */
let suggIdx = 0, suggList = [];
function updateSugg0(){
  const q = norm($('#q').value), ul = $('#sugg');
  if(!q){ ul.hidden = true; return; }
  const words = q.split(' ');
  suggList = S.tasks.filter(t => !S.active.has(t.id) && words.every(w => norm(t.name + ' ' + t.trader).includes(w)))
    .sort((a,b) => (norm(a.name).startsWith(q)?0:1) - (norm(b.name).startsWith(q)?0:1) || a.name.localeCompare(b.name)).slice(0,9);
  suggIdx = 0;
  ul.innerHTML = suggList.map((t,i) => `<li data-i="${i}" class="${i===0?'sel':''}">${esc(t.name)}<small class="tr">${avatarHTML(t.traderId || t.trader, 18)}${esc(t.trader)}</small></li>`).join('') || '<li style="cursor:default;color:var(--mute)">No matching quest</li>';
  ul.hidden = false;
}
function pickSugg(i){
  const t = suggList[i]; if(!t) return;
  S.active.add(t.id); saveActive(); $('#q').value = ''; $('#sugg').hidden = true; refresh();
}
function matchTask(line){
  const n = norm(line); if(!n) return null;
  let t = S.tasks.find(t => norm(t.name) === n); if(t) return t;
  const inc = S.tasks.filter(t => norm(t.name).includes(n) || n.includes(norm(t.name)));
  if(inc.length === 1) return inc[0];
  const words = new Set(n.split(' ')); let best = null, bs = 0;
  S.tasks.forEach(t => {
    const tw = norm(t.name).split(' '); const hit = tw.filter(w => words.has(w)).length;
    const sc = hit / Math.max(tw.length, words.size);
    if(sc > bs){ bs = sc; best = t; }
  });
  return bs >= 0.6 ? best : null;
}

/* ============ header tabs + right panel ============ */
function renderTabs(){
  const best = S.an.ranked[0];
  $('#tabs').innerHTML = MAPS.map(k => {
    const a = S.an.A[k];
    const sub = a.score > 0 ? `${a.full.size} quest${a.full.size===1?'':'s'} · ${a.groups.length + a.anywhere.length} obj` : 'nothing here';
    return `<button data-k="${k}" class="${k===S.curMap?'cur':''} ${a.score>0?'':'dim'} ${k===best?'best':''}"><b>${MAP_LABEL[k]}${k===best?' ★':''}</b><small>${sub}</small></button>`;
  }).join('');
  document.querySelectorAll('#tabs button').forEach(b => b.addEventListener('click', () => openMap(b.dataset.k)));
}
const fmt = m => m >= 1000 ? (m/1000).toFixed(2)+' km' : Math.round(m)+' m';
function renderRoute0(){
  const box = $('#route'), an = S.an, k = S.curMap, a = k && an.A[k];
  if(!S.active.size){
    box.innerHTML = '<div class="empty"><b>Pick your quests</b>Add what you have active on the left. This panel then ranks the maps and lays out the shortest order to hit every objective on the map you are viewing.</div>';
    return;
  }
  let html = '';
  const best = an.ranked[0];
  if(best){
    const b = an.A[best];
    html += `<div class="best-card"><b>Best map right now: ${MAP_LABEL[best]}</b><div class="muted" style="margin-top:2px">Finishes ${b.full.size} quest${b.full.size===1?'':'s'} outright and touches ${b.groups.length + b.anywhere.length} objectives${b.part.size?`, plus progress on ${b.part.size} more`:''}.</div>
      ${best!==k?`<div class="row"><button class="primary" id="goBest">Open ${MAP_LABEL[best]}</button></div>`:''}</div>`;
  } else {
    html += '<div class="empty"><b>No map objectives left</b>Everything left on your quests is a turn-in or has no map. Untick objectives on the left if that is not right.</div>';
  }
  if(a){
    if(a.route){
      const r = a.route;
      html += `<div class="statline"><div><b>${r.stops.length}</b><span>stops</span></div><div><b>${fmt(r.len)}</b><span>on foot between stops</span></div>${r.exit?`<div><b>${fmt(r.exit.dist)}</b><span>to ${esc(r.exit.e.name)}</span></div>`:''}</div>`;
      html += '<ol class="steps">' + r.stops.map((s,i) => {
        const d = i ? dist(r.stops[i-1].p, s.p) : null;
        return `<li data-i="${i}"><span class="n">${i+1}</span><div>${s.items.map(it => `<div class="it"><i style="color:${qColor(it.g.t)}">${esc(it.g.t.name)}</i> — ${esc(it.g.o.desc)}</div>`).join('')}<div class="d">${d==null?'Start here':fmt(d)+' from previous stop'}</div></div></li>`;
      }).join('') + (r.exit ? `<li data-x="1"><span class="n x">⇥</span><div><div class="it"><i>Extract: ${esc(r.exit.e.name)}</i></div><div class="d">Nearest ${S.opts.faction==='scav'?'Scav':'PMC'} exit to your last stop · ${fmt(r.exit.dist)}</div></div></li>` : '') + '</ol>';
    } else if(!a.anywhere.length){
      html += `<div class="empty"><b>Nothing on ${MAP_LABEL[k]}</b>None of your active quests have objectives here.</div>`;
    }
    if(a.anywhere.length) html += `<div class="listbox"><h3>Anywhere on ${MAP_LABEL[k]}</h3>${a.anywhere.map(x => `<div><span class="swatch" style="display:inline-block;background:${qColor(x.t)};margin-right:6px"></span><b>${esc(x.t.name)}</b> — ${esc(x.o.desc)}</div>`).join('')}</div>`;
  }
  if(an.flex.length) html += `<div class="listbox"><h3>Any map (found in raid)</h3>${an.flex.map(x => `<div><span class="swatch" style="display:inline-block;background:${qColor(x.t)};margin-right:6px"></span><b>${esc(x.t.name)}</b> — ${esc(x.o.desc)}</div>`).join('')}</div>`;
  if(an.turnin.length) html += `<div class="listbox"><h3>Hand-ins and other</h3><div class="muted">${an.turnin.map(x => esc(x.t.name)+': '+esc(x.o.desc)).join('<br>')}</div></div>`;
  box.innerHTML = html;
  const gb = $('#goBest'); if(gb) gb.addEventListener('click', () => openMap(best));
  box.querySelectorAll('.steps li[data-i]').forEach(li => li.addEventListener('click', () => focusStop(+li.dataset.i)));
  box.querySelectorAll('.steps li[data-x]').forEach(li => li.addEventListener('click', () => { const ex = a.route.exit; if(S.map && ex) S.map.flyTo([ex.e.p.z, ex.e.p.x], S.fitZoom + 2); }));
}
function focusStop(i){
  const a = S.an.A[S.curMap]; if(!a || !a.route || !S.map) return;
  const p = a.route.stops[i].p;
  S.map.flyTo([p.z, p.x], Math.max(S.map.getZoom(), S.fitZoom + 2));
  if(S.stopMarkers && S.stopMarkers[i]) S.stopMarkers[i].openPopup();
}

/* ============ map ============ */
function rot(x, y, deg){ const r = deg*Math.PI/180, c = Math.cos(r), s = Math.sin(r); return [c*x + s*y, c*y - s*x]; }
const getAl = k => Object.assign({ k:0, m:false, swap:null }, S.align[k] || {});
function makeCRS(cal, al){
  const ang = (cal.rotation + 90*al.k);
  const t = cal.transform;
  return L.Util.extend({}, L.CRS.Simple, {
    projection: {
      bounds: L.bounds([-1e7,-1e7],[1e7,1e7]),
      project(ll){ let x = ll.lng, y = ll.lat; if(al.m) x = -x; const r = rot(x, y, ang); return L.point(r[0], r[1]); },
      unproject(p){ const r = rot(p.x, p.y, -ang); let x = r[0]; if(al.m) x = -x; return L.latLng(r[1], x); }
    },
    transformation: new L.Transformation(t[0], t[1], -t[2], t[3])
  });
}
function detectBoundsMode(k, cal){
  const b = cal.bounds; if(!b) return 'zx';
  const pts = (S.extracts[k] || []).map(e => e.p);
  S.tasks.forEach(t => t.objs.forEach(o => (o.pts[k] || []).forEach(p => pts.push(p))));
  if(!pts.length) return 'zx';
  const rng = i => [Math.min(b[0][i], b[1][i]), Math.max(b[0][i], b[1][i])];
  const r0 = rng(0), r1 = rng(1), pad = 0.05;
  const inr = (v, r) => v >= r[0] - (r[1]-r[0])*pad && v <= r[1] + (r[1]-r[0])*pad;
  let zx = 0, xz = 0;
  pts.forEach(p => { if(inr(p.z, r0) && inr(p.x, r1)) zx++; if(inr(p.x, r0) && inr(p.z, r1)) xz++; });
  return xz > zx ? 'xz' : 'zx';
}
function overlayBounds(k, cal, mode){
  let b = cal.bounds;
  if(!b){
    const pts = (S.extracts[k] || []).map(e => e.p);
    if(!pts.length) return null;
    const xs = pts.map(p => p.x), zs = pts.map(p => p.z);
    b = [[Math.min(...zs)-50, Math.min(...xs)-50],[Math.max(...zs)+50, Math.max(...xs)+50]]; mode = 'zx';
  }
  return mode === 'xz' ? L.latLngBounds([[b[0][1], b[0][0]],[b[1][1], b[1][0]]]) : L.latLngBounds([[b[0][0], b[0][1]],[b[1][0], b[1][1]]]);
}
async function getSvg(k){
  if(!S.svgCache[k]){
    const r = await fetch(SVG_BASE + SVG_FILES[k] + '.svg');
    if(!r.ok) throw new Error('map image download failed (HTTP '+r.status+')');
    S.svgCache[k] = await r.text();
  }
  const doc = new DOMParser().parseFromString(S.svgCache[k], 'image/svg+xml');
  const el = doc.documentElement;
  if(el.nodeName.toLowerCase() !== 'svg') throw new Error('map image was not valid SVG');
  el.removeAttribute('width'); el.removeAttribute('height');
  el.setAttribute('preserveAspectRatio', 'none');
  return document.importNode(el, true);
}
function mapMsg(txt){ const m = $('#mapmsg'); if(!txt){ m.classList.remove('show'); return; } m.querySelector('p').textContent = txt; m.classList.add('show'); }

async function openMap(k){
  if(!k) return;
  S.curMap = k; LS.set('rr_map', k);
  document.querySelectorAll('#tabs button').forEach(b => b.classList.toggle('cur', b.dataset.k === k));
  renderRoute();
  const cal = S.cal[k];
  if(S.map){ S.map.remove(); S.map = null; }
  $('#floors').innerHTML = '';
  if(!cal){ mapMsg('No calibration data for '+MAP_LABEL[k]+'. Press Refresh data.'); return; }
  mapMsg('Loading '+MAP_LABEL[k]+'…');
  const token = ++S.openToken || (S.openToken = 1);
  let svg;
  try{ svg = await getSvg(k); }
  catch(e){ if(token === S.openToken) mapMsg('Could not load the '+MAP_LABEL[k]+' map: '+e.message+'. Check your connection and try again.'); return; }
  if(token !== S.openToken) return;
  const al = getAl(k);
  const bmode = al.swap || detectBoundsMode(k, cal);
  const bounds = overlayBounds(k, cal, bmode);
  if(!bounds){ mapMsg('This map has no bounds data.'); return; }
  const crs = makeCRS(cal, al);
  const map = L.map('map', { crs, zoomSnap:0.25, zoomDelta:0.5, wheelPxPerZoomLevel:80, minZoom:-8, maxZoom:10, attributionControl:false });
  S.map = map;
  L.svgOverlay(svg, bounds, { interactive:false }).addTo(map);
  map.fitBounds(bounds, { animate:false });
  S.fitZoom = map.getZoom();
  map.setMinZoom(S.fitZoom - 1.5); map.setMaxZoom(S.fitZoom + 5);
  map.setMaxBounds(bounds.pad(0.4));
  S.layer = L.layerGroup().addTo(map);
  setupFloors(svg, cal);
  $('#alInfo').textContent = `Rotation ${((cal.rotation + 90*al.k) % 360 + 360) % 360}°${al.m?' · mirrored':''} · bounds read as ${bmode==='xz'?'x/z':'z/x'}${al.swap?' (manual)':' (auto)'}`;
  mapMsg('');
  drawOverlay();
}
function setupFloors(svg, cal){
  const gs = [...svg.children].filter(c => c.tagName.toLowerCase() === 'g' && c.id);
  const bar = $('#floors');
  if(gs.length < 2){ bar.innerHTML = ''; return; }
  const base = gs.find(g => g.id === cal.layer) || null;
  const apply = id => {
    gs.forEach(g => {
      if(id === '__all'){ g.style.display = ''; g.style.opacity = ''; return; }
      if(g.id === id){ g.style.display = ''; g.style.opacity = ''; }
      else if(base && g === base){ g.style.display = ''; g.style.opacity = '0.35'; }
      else g.style.display = 'none';
    });
    bar.querySelectorAll('button').forEach(b => b.classList.toggle('on', b.dataset.f === id));
  };
  bar.innerHTML = '<button data-f="__all">All floors</button>' + gs.map(g => `<button data-f="${esc(g.id)}">${esc(g.id.replace(/_/g,' '))}</button>`).join('');
  bar.querySelectorAll('button').forEach(b => b.addEventListener('click', () => apply(b.dataset.f)));
  apply(base ? base.id : '__all');
}
function popupFor(items, extra){
  const el = document.createElement('div'); el.className = 'pop';
  if(extra) el.innerHTML = extra;
  items.forEach(it => {
    const d = document.createElement('div'); d.className = 'pi';
    d.innerHTML = `<b style="color:${qColor(it.t)}">${esc(it.t.name)}</b>${esc(it.o.desc)}<br>`;
    const b = document.createElement('button'); b.textContent = 'Mark objective done';
    b.addEventListener('click', () => toggleDone(it.o.id, true));
    d.appendChild(b); el.appendChild(d);
  });
  return el;
}
function drawOverlay(){
  const k = S.curMap, map = S.map; if(!map || !S.layer) return;
  const a = S.an.A[k]; S.layer.clearLayers(); S.stopMarkers = [];
  a.groups.forEach(g => (g.o.polys[k] || []).forEach(poly =>
    L.polygon(poly.map(p => [p.z, p.x]), { color:qColor(g.t), weight:1.5, opacity:.85, fillOpacity:.12, interactive:false }).addTo(S.layer)));
  if(S.opts.extracts) extractsFor(k).forEach(e =>
    L.marker([e.p.z, e.p.x], { icon:L.divIcon({ className:'ext '+e.faction, html:'<span></span>', iconSize:[16,16] }), zIndexOffset:-500 })
      .bindTooltip(e.name + ' · ' + e.faction.toUpperCase()).addTo(S.layer));
  const chosen = new Set();
  if(a.route){
    a.route.stops.forEach(s => s.items.forEach(it => chosen.add(it.p)));
    const pts = a.route.stops.map(s => [s.p.z, s.p.x]);
    if(a.route.exit) {
      L.polyline([pts[pts.length-1], [a.route.exit.e.p.z, a.route.exit.e.p.x]], { color:'#e9e4d4', weight:2, opacity:.7, dashArray:'3 7', interactive:false }).addTo(S.layer);
    }
    if(pts.length > 1) L.polyline(pts, { color:'#ffb23e', weight:3.5, opacity:.95, dashArray:'10 6', className:'route-line', interactive:false }).addTo(S.layer);
  }
  // alternative locations that were not chosen
  a.groups.forEach(g => g.pts.forEach(p => {
    if(chosen.has(p)) return;
    L.circleMarker([p.z, p.x], { radius:6, color:qColor(g.t), weight:2, fillOpacity:.15 })
      .bindPopup(popupFor([g], '<b>Alternative spot</b>')).addTo(S.layer);
  }));
  if(a.route) a.route.stops.forEach((s,i) => {
    const m = L.marker([s.p.z, s.p.x], { icon:L.divIcon({ className:'stop', html:`<span>${i+1}</span>`, iconSize:[28,28] }), zIndexOffset:1000 })
      .bindPopup(popupFor(s.items.map(it => it.g), `<b>Stop ${i+1}</b>`)).addTo(S.layer);
    S.stopMarkers.push(m);
  });
}

/* ============ refresh pipeline ============ */
function refresh(){
  S.an = analyze();
  if(!S.curMap || (S.an.ranked.length && S.an.A[S.curMap].score === 0 && !S.userPickedMap)) {
    // keep current map if the user chose it; otherwise follow the best map
  }
  renderQuests(); renderTabs(); renderRoute();
  if(S.map) drawOverlay();
}
function setOv(t){ $('#ovtext').textContent = t; }
function showOvError(e){
  $('#overlay').classList.remove('hide');
  $('#overlay').innerHTML = `<h2>Raid Route</h2><div class="err">${esc(e.message || e)}</div><div class="row"><button class="primary" id="retry">Try again</button></div>`;
  $('#retry').addEventListener('click', () => { $('#overlay').innerHTML = '<h2>Raid Route</h2><div id="ovtext" class="muted">Loading…</div>'; boot(true); });
}
async function boot(force){
  $('#overlay').classList.remove('hide');
  try{
    await loadCal(force);
    await loadTasks(force);
  }catch(e){ console.error(e); showOvError(e); return; }
  S.byId = new Map(S.tasks.map(t => [t.id, t]));
  [...S.active].forEach(id => { if(!S.byId.has(id)) S.active.delete(id); });
  saveActive();
  if(!S.curMap || !SVG_FILES[S.curMap]) S.curMap = 'customs';
  S.an = analyze();
  if(S.active.size && S.an.ranked.length && S.an.A[S.curMap].score === 0) S.curMap = S.an.ranked[0];
  $('#overlay').classList.add('hide');
  document.querySelectorAll('#modeSeg button').forEach(b => b.classList.toggle('on', b.dataset.m === S.mode));
  $('#optExt').checked = S.opts.extracts; $('#optFac').value = S.opts.faction; $('#optOptional').checked = S.opts.optional;
  $('#refresh').title = 'Quest data from ' + new Date(S.stamp).toLocaleString() + ' (' + S.tasks.length + ' quests). Click to re-download.';
  renderQuests(); renderTabs(); renderRoute();
  await openMap(S.curMap);
}

/* ============ pre-raid checklist ============ */
const packed = new Set(LS.get('rr_packed', []));
let prepScope = LS.get('rr_prepScope', 'map');
const savePacked = () => LS.set('rr_packed', [...packed]);

function prepCollect(scope){
  const k = S.curMap;
  const act = [...S.active].map(id => S.byId.get(id)).filter(Boolean);
  const R = { keys:new Map(), bring:new Map(), gear:[] };
  const bump = (m, sig, init, n, q, maps) => {
    let r = m.get(sig);
    if(!r){ r = Object.assign({ sig, count:0, quests:new Set(), maps:new Set() }, init); m.set(sig, r); }
    r.count += n; r.quests.add(q); (maps || []).forEach(x => r.maps.add(x));
    return r;
  };
  act.forEach(t => {
    const objs = t.objs.filter(o => !S.done.has(o.id) && (S.opts.optional || !o.optional));
    const rel = o => scope === 'all' || o.maps.has(k) || o.flex;      /* turn-ins and workbench builds (o.nonmap) are not tied to a raid */
    const here = objs.some(o => o.maps.has(k));
    const labels = o => [...o.maps].map(m => MAP_LABEL[m] || m);
    const covered = new Set();
    objs.forEach(o => {
      const q = o.req; if(!q || !rel(o)) return;
      (q.keys || []).forEach((g, i) => {
        const km = (q.keyMaps || [])[i];
        if(scope !== 'all' && km && km.length && !km.includes(k)) return;      /* this key opens nothing on the map you are viewing */
        g.forEach(n => covered.add(n)); bump(R.keys, 'k|' + g.join('|'), { names:g }, 0, t.name, labels(o));
      });
      (q.bring || []).forEach(b => bump(R.bring, 'b|' + b.note + '|' + b.names.join('|'),
        { names:b.names, note:b.note, fir:b.fir }, b.count || 1, t.name, labels(o)));
      if(q.gear){
        const g = { quest:t.name, text:o.desc, maps:labels(o), sig:'g|' + t.id + '|' + o.id };
        if(o.type === 'buildWeapon') (R.builds = R.builds || []).push(g); else R.gear.push(g);
      }
    });
    (t.keys || []).forEach(kk => {
      if(kk.names.every(n => covered.has(n))) return;
      if(scope === 'all' || (kk.map === k && here)) bump(R.keys, 'k|' + kk.names.join('|'), { names:kk.names }, 0, t.name, [MAP_LABEL[kk.map] || kk.map]);
    });
  });
  return R;
}
function prepHTML(scope){
  const R = prepCollect(scope);
  const ids = [];
  const nm = names => {
    const s = names.length > 3 ? names.slice(0,3).join(' / ') + ' / +' + (names.length - 3) + ' more' : names.join(' / ');
    return '<span title="' + esc(names.join(' / ')) + '">' + esc(s) + '</span>';
  };
  const sub = r => [...r.quests].map(esc).join(', ') + (scope === 'all' && r.maps.size ? ' · ' + [...r.maps].map(esc).join(', ') : '');
  const row = (id, lead, text, small) => {
    ids.push(id);
    return '<label class="pr ' + (packed.has(id) ? 'on' : '') + '"><input type="checkbox" data-r="' + esc(id) + '" ' + (packed.has(id) ? 'checked' : '') +
      '><span>' + (lead ? '<b>' + lead + '</b>' : '') + text + '<small>' + small + '</small></span></label>';
  };
  let h = '';
  const keys = [...R.keys.values()].sort((a,b) => a.names[0].localeCompare(b.names[0]));
  if(keys.length) h += '<h3>Keys</h3>' + keys.map(r => row(r.sig, '', nm(r.names), sub(r))).join('');
  const bring = [...R.bring.values()].sort((a,b) => a.names[0].localeCompare(b.names[0]));
  if(bring.length) h += '<h3>Bring into the raid</h3>' + bring.map(r =>
    row(r.sig, r.count + '×', nm(r.names) + ' <span class="muted">(' + esc(r.note) + ')</span>' + (r.fir ? '<span class="fir">found in raid</span>' : ''), sub(r))).join('');
  if(R.gear.length) h += '<h3>Weapon / gear conditions</h3>' + R.gear.map(g =>
    row(g.sig, '', esc(g.text), esc(g.quest) + (scope === 'all' && g.maps.length ? ' · ' + g.maps.map(esc).join(', ') : ''))).join('');
  if(R.builds && R.builds.length) h += '<h3>Weapon builds (hideout workbench, no raid needed)</h3>' + R.builds.map(g =>
    row(g.sig, '', esc(g.text), esc(g.quest))).join('');
  return { html:h, ids };
}
function renderPrep(){
  const btn = $('#prepBtn'); if(!btn || !S.byId.size) return;
  const { html, ids } = prepHTML(prepScope);
  const open = ids.filter(id => !packed.has(id)).length;
  btn.textContent = 'Pre-raid check' + (open ? ' (' + open + ')' : '');
  const dlg = $('#prepDlg');
  if(dlg.open){
    $('#prepScopeSeg').querySelectorAll('button').forEach(b => b.classList.toggle('on', b.dataset.s === prepScope));
    $('#prepSub').textContent = !S.active.size ? '' : (prepScope === 'map'
      ? 'For ' + (MAP_LABEL[S.curMap] || S.curMap) + ': what your selected quests need on this map: keys, items to bring and gear.'
      : 'Everything to bring for your selected quests, across all maps.');
    $('#prepBody').innerHTML = !S.active.size
      ? '<div class="empty"><b>No quests selected</b>Add your active quests first.</div>'
      : (html || '<div class="empty"><b>Nothing to bring</b>None of your remaining objectives need keys, items or special gear' + (prepScope === 'map' ? ' on this map' : '') + '.</div>');
  }
}
(function wirePrep(){
  const dlg = $('#prepDlg');
  $('#prepBtn').addEventListener('click', () => { dlg.showModal(); renderPrep(); });
  $('#prepClose').addEventListener('click', () => dlg.close());
  $('#prepReset').addEventListener('click', () => { packed.clear(); savePacked(); renderPrep(); });
  $('#prepScopeSeg').addEventListener('click', e => {
    const b = e.target.closest('button[data-s]'); if(!b) return;
    prepScope = b.dataset.s; LS.set('rr_prepScope', prepScope); renderPrep();
  });
  $('#prepBody').addEventListener('change', e => {
    const cb = e.target.closest('input[data-r]'); if(!cb) return;
    if(cb.checked) packed.add(cb.dataset.r); else packed.delete(cb.dataset.r);
    savePacked(); renderPrep();
  });
})();
function renderRoute(){ renderRoute0(); renderPrep(); }

/* ============ trader search + photos ============ */
let traderSel = null, traderQ = '';
const traderOf = key => (S.traders || []).find(t => t.id === key) || null;
function avatarHTML(key, size){
  const tr = traderOf(key);
  const ini = esc(((tr && tr.name) || '?').slice(0, 2));
  const img = tr && tr.image ? '<img src="' + esc(tr.image) + '" alt="" loading="lazy" onerror="this.remove()">' : '';
  return '<span class="av" style="--s:' + size + 'px">' + ini + img + '</span>';
}
function traderGroups(){
  const g = new Map();
  S.tasks.forEach(t => {
    const k = t.traderId || t.trader; if(!k) return;
    if(!g.has(k)) g.set(k, { key:k, name:t.trader || k, tasks:[] });
    g.get(k).tasks.push(t);
  });
  return [...g.values()].sort((a, b) => b.tasks.length - a.tasks.length);
}
function renderTraderBar(){
  const bar = $('#traderBar'); if(!bar || !S.tasks.length) return;
  const groups = traderGroups();
  let sel = groups.find(g => g.key === traderSel) || null;
  if(!sel) traderSel = null;
  const prevList = $('#traderList'), prev = prevList ? prevList.scrollTop : 0;
  let h = '<div class="tchips" role="group" aria-label="Browse quests by trader">' + groups.map(g =>
    '<button class="tchip ' + (g.key === traderSel ? 'on' : '') + '" data-t="' + esc(g.key) + '" title="' + esc(g.name) + ' · ' + g.tasks.length +
    ' quests" aria-pressed="' + (g.key === traderSel) + '">' + avatarHTML(g.key, 34) + '<small>' + esc(g.name) + '</small></button>').join('') + '</div>';
  if(sel){
    const q = norm(traderQ), words = q ? q.split(' ') : [];
    const rows = sel.tasks.filter(t => words.every(w => norm(t.name).includes(w)))
      .sort((a, b) => (a.level || 0) - (b.level || 0) || a.name.localeCompare(b.name));
    h += '<div class="tlist-h"><b>' + esc(sel.name) + '</b><span class="muted">' + rows.length + ' of ' + sel.tasks.length + ' quests' +
      (q ? ' match' : '') + '</span><button class="quiet" id="tClear">Clear</button></div><div id="traderList">' +
      (rows.map(t => {
        const on = S.active.has(t.id);
        return '<button class="trow ' + (on ? 'added' : '') + '" data-id="' + esc(t.id) + '" ' + (on ? 'disabled' : '') + '><span class="lv">' +
          (t.level ? 'Lv ' + t.level : '') + '</span><span class="tn">' + esc(t.name) + '</span><span class="ta">' + (on ? '✓ added' : '+ add') + '</span></button>';
      }).join('') || '<div class="muted" style="padding:8px">No quests match.</div>') + '</div>';
  }
  bar.innerHTML = h;
  const nl = $('#traderList'); if(nl) nl.scrollTop = prev;
}
function renderQuests(){ renderQuests0(); renderTraderBar(); }
function updateSugg(){
  if(traderSel){ traderQ = $('#q').value; $('#sugg').hidden = true; suggList = []; renderTraderBar(); return; }
  updateSugg0();
}
(function wireTraders(){
  $('#q').closest('.combo').insertAdjacentHTML('afterend', '<div id="traderBar"></div>');
  const bar = $('#traderBar');
  bar.addEventListener('click', e => {
    const chip = e.target.closest('.tchip');
    if(chip){
      traderSel = traderSel === chip.dataset.t ? null : chip.dataset.t;
      traderQ = traderSel ? $('#q').value : '';
      $('#sugg').hidden = true; renderTraderBar(); return;
    }
    if(e.target.closest('#tClear')){ traderSel = null; traderQ = ''; renderTraderBar(); updateSugg(); return; }
    const row = e.target.closest('.trow');
    if(row && !row.disabled){ S.active.add(row.dataset.id); saveActive(); refresh(); }
  });
  $('#q').addEventListener('keydown', e => {
    if(e.key !== 'Enter' || !traderSel) return;
    const row = document.querySelector('#traderList .trow:not(:disabled)');
    if(row){ $('#q').value = ''; traderQ = ''; row.click(); }
  });
})();

/* ============ key routes ============ */
S.locks = S.locks || {};
S.myKeys = new Set(LS.get('rr_keys', []));
const saveKeys = () => LS.set('rr_keys', [...S.myKeys]);
const KCOL = '#4fd1e0';
const KEY_CSS = `
#keysBtn{white-space:nowrap}
#keysDlg{width:min(700px,94vw)}
#keysDlg[open]{display:flex;flex-direction:column;max-height:88vh}
#keysDlg .kh{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
#keysDlg .kh h2{margin:0}
#keysDlg .ktools{display:flex;gap:8px;flex-wrap:wrap;margin:8px 0}
#keysDlg .ktools input[type=text]{flex:1;min-width:160px;background:var(--bg);border:1px solid var(--line);border-radius:5px;padding:7px 10px}
#keysDlg select{background:var(--bg);color:var(--text);border:1px solid var(--line);border-radius:5px;padding:6px}
#kBody{overflow-y:auto;min-height:0;flex:1;margin:6px 0;padding-right:4px}
label.kr{display:flex;gap:9px;align-items:flex-start;padding:6px 4px;border-bottom:1px solid var(--line);cursor:pointer}
label.kr:hover{background:var(--panel2)}
label.kr input{margin-top:4px}
label.kr b{font-weight:600;margin-right:6px}
label.kr small{display:block;color:var(--mute);font-size:12px;margin-top:1px}
.kstop{background:none;border:0}
.kstop span{display:grid;place-items:center;width:26px;height:26px;border-radius:6px;background:${KCOL};color:#06242a;font:700 15px/1 var(--f-head);border:2px solid #06242a;box-shadow:0 0 0 2px ${KCOL},0 2px 6px #000a}
#keyroute .kr-h{display:flex;align-items:center;justify-content:space-between;padding:12px 14px 6px;border-top:1px solid var(--line)}
#keyroute .kr-h h2{margin:0;font:600 18px var(--f-head);letter-spacing:.02em;color:${KCOL}}
.ksteps .n{background:${KCOL};color:#06242a;border-radius:6px}
`;

function normalizeLocks(raw){
  const out = {};
  (raw || []).forEach(m => {
    const k = canon(m.normalizedName); if(!k || !SVG_FILES[k]) return;
    const arr = out[k] = out[k] || [];
    (m.locks || []).forEach(l => {
      const p = l.position; if(!p || p.x == null || p.z == null || !l.keyId) return;
      if(arr.some(a => a.id === l.id || (a.keyId === l.keyId && Math.abs(a.p.x - p.x) < 1 && Math.abs(a.p.z - p.z) < 1))) return;
      arr.push({ id:l.id, keyId:l.keyId, key:l.key || l.keyId, type:l.type || 'door', power:!!l.power, p:{ x:p.x, y:p.y || 0, z:p.z } });
    });
  });
  return out;
}
{ const _ne = normalizeExtracts; normalizeExtracts = function(raw){ S.locks = normalizeLocks(raw); return _ne(raw); }; }

function keyIndex(){
  const m = new Map();
  Object.keys(S.locks).forEach(mk => S.locks[mk].forEach(l => {
    let e = m.get(l.keyId); if(!e){ e = { id:l.keyId, name:l.key, maps:new Map() }; m.set(l.keyId, e); }
    e.maps.set(mk, (e.maps.get(mk) || 0) + 1);
  }));
  return [...m.values()];
}
function neededKeyNames(){
  const need = new Map();
  [...S.active].map(id => S.byId.get(id)).filter(Boolean).forEach(t => {
    const add = n => { if(!need.has(n)) need.set(n, new Set()); need.get(n).add(t.name); };
    t.objs.filter(o => !S.done.has(o.id) && (S.opts.optional || !o.optional)).forEach(o => o.req && o.req.keys && o.req.keys.forEach(g => g.forEach(add)));
    (t.keys || []).forEach(kk => kk.names.forEach(add));
  });
  return need;
}

const keySigCache = {};
function keyRoute(k){
  const locks = (S.locks[k] || []).filter(l => S.myKeys.has(l.keyId));
  if(!locks.length) return null;
  const sig = k + '|' + locks.map(l => l.id).sort().join(',') + '|' + S.opts.faction;
  if(keySigCache[sig]) return keySigCache[sig];
  const r = buildRoute({ groups:locks.map(l => ({ lock:l, pts:[l.p] })), key:k });
  r.count = locks.length;
  return (keySigCache[sig] = r);
}
const kLine = it => {
  const l = it.g.lock;
  return '<b style="color:#1c6f78">' + esc(l.key) + '</b>' + (l.type === 'trunk' ? 'Trunk / container' : 'Door') + (l.power ? ' · needs power' : '');
};
function drawKeys(){
  const k = S.curMap, map = S.map; S.keyMarkers = [];
  if(!map || !S.layer || S.opts.showKeys === false) return;
  const r = keyRoute(k); if(!r) return;
  const pts = r.stops.map(s => [s.p.z, s.p.x]);
  if(r.exit) L.polyline([pts[pts.length - 1], [r.exit.e.p.z, r.exit.e.p.x]], { color:'#8fe3ee', weight:2, opacity:.7, dashArray:'3 7', interactive:false }).addTo(S.layer);
  if(pts.length > 1) L.polyline(pts, { color:KCOL, weight:3, opacity:.95, dashArray:'4 8', className:'route-line', interactive:false }).addTo(S.layer);
  r.stops.forEach((s, i) => {
    const el = document.createElement('div'); el.className = 'pop';
    el.innerHTML = '<b>Key stop ' + (i + 1) + '</b>' + s.items.map(it => '<div class="pi">' + kLine(it) + '</div>').join('');
    S.keyMarkers.push(L.marker([s.p.z, s.p.x], { icon:L.divIcon({ className:'kstop', html:'<span>' + (i + 1) + '</span>', iconSize:[26, 26] }), zIndexOffset:900 })
      .bindPopup(el).addTo(S.layer));
  });
}
function renderKeyRoute(){
  const box = $('#keyroute'); if(!box) return;
  const k = S.curMap;
  if(S.opts.showKeys === false || !k || !S.tasks.length){ box.innerHTML = ''; return; }
  let h = '<div class="kr-h"><h2>Key route · ' + esc(MAP_LABEL[k] || k) + '</h2><button class="quiet" id="krManage">My keys' + (S.myKeys.size ? ' (' + S.myKeys.size + ')' : '') + '</button></div>';
  const r = S.myKeys.size ? keyRoute(k) : null;
  if(!S.myKeys.size){
    h += '<div class="empty"><b>No keys yet</b>Tick the keys you own and this plans the fastest run past every door and container they open on this map.<div class="row"><button class="primary" id="krAdd">Add my keys</button></div></div>';
  } else if(!r){
    h += '<div class="empty"><b>Nothing on ' + esc(MAP_LABEL[k] || k) + '</b>None of your ' + S.myKeys.size + ' key' + (S.myKeys.size === 1 ? '' : 's') + ' open anything on this map.</div>';
  } else {
    h += '<div class="statline"><div><b>' + r.count + '</b><span>locks</span></div><div><b>' + r.stops.length + '</b><span>stops</span></div><div><b>' + fmt(r.len) + '</b><span>on foot between stops</span></div>' +
      (r.exit ? '<div><b>' + fmt(r.exit.dist) + '</b><span>to ' + esc(r.exit.e.name) + '</span></div>' : '') + '</div>';
    h += '<ol class="steps ksteps">' + r.stops.map((s, i) => {
      const d = i ? dist(r.stops[i - 1].p, s.p) : null;
      return '<li data-i="' + i + '"><span class="n">' + (i + 1) + '</span><div>' + s.items.map(it => '<div class="it">' + kLine(it).replace('color:#1c6f78', 'color:' + KCOL) + '</div>').join('') +
        '<div class="d">' + (d == null ? 'Start here' : fmt(d) + ' from previous stop') + '</div></div></li>';
    }).join('') + (r.exit ? '<li data-x="1"><span class="n x">⇥</span><div><div class="it"><i>Extract: ' + esc(r.exit.e.name) + '</i></div><div class="d">Nearest ' + (S.opts.faction === 'scav' ? 'Scav' : 'PMC') + ' exit to your last stop · ' + fmt(r.exit.dist) + '</div></div></li>' : '') + '</ol>';
  }
  box.innerHTML = h;
  const mg = $('#krManage'), ad = $('#krAdd'); if(mg) mg.addEventListener('click', openKeysDlg); if(ad) ad.addEventListener('click', openKeysDlg);
  box.querySelectorAll('.ksteps li[data-i]').forEach(li => li.addEventListener('click', () => {
    const rt = keyRoute(S.curMap); if(!rt || !S.map) return;
    const s = rt.stops[+li.dataset.i];
    S.map.flyTo([s.p.z, s.p.x], Math.max(S.map.getZoom(), S.fitZoom + 2));
    if(S.keyMarkers && S.keyMarkers[+li.dataset.i]) S.keyMarkers[+li.dataset.i].openPopup();
  }));
  box.querySelectorAll('.ksteps li[data-x]').forEach(li => li.addEventListener('click', () => {
    const rt = keyRoute(S.curMap); if(rt && rt.exit && S.map) S.map.flyTo([rt.exit.e.p.z, rt.exit.e.p.x], S.fitZoom + 2);
  }));
}

let kShowOwned = false, kMap = 'all';
function updateKeysUI(){
  const n = S.myKeys.size;
  const b = $('#keysBtn'); if(b) b.textContent = 'My keys' + (n ? ' (' + n + ')' : '');
  const c = $('#kCount'); if(c) c.textContent = n + ' owned';
}
function renderKeysDlg(){
  const body = $('#kBody'), prev = body.scrollTop;
  const all = keyIndex(), need = neededKeyNames();
  const q = norm($('#kq').value), words = q ? q.split(' ') : [];
  const rows = all.filter(e => words.every(w => norm(e.name).includes(w)) && (kMap === 'all' || e.maps.has(kMap)) && (!kShowOwned || S.myKeys.has(e.id)))
    .sort((a, b) => (need.has(b.name) ? 1 : 0) - (need.has(a.name) ? 1 : 0) || a.name.localeCompare(b.name));
  $('#kNeed').hidden = !need.size;
  updateKeysUI();
  body.innerHTML = !all.length
    ? '<div class="empty"><b>No key location data</b>Rebuild quest_data.json with the latest build_quest_data.py (it needs maps_data.json and items_en.json), then rebuild the page.</div>'
    : (rows.map(e => '<label class="kr"><input type="checkbox" data-k="' + esc(e.id) + '" ' + (S.myKeys.has(e.id) ? 'checked' : '') + '><span><b>' + esc(e.name) + '</b>' +
        (need.has(e.name) ? '<span class="tag opt">needed for your quests</span>' : '') + '<small>' +
        [...e.maps].map(([mk, n]) => esc(MAP_LABEL[mk] || mk) + ' ×' + n).join(' · ') + '</small></span></label>').join('') || '<div class="empty">No keys match.</div>');
  body.scrollTop = prev;
}
function openKeysDlg(){ $('#keysDlg').showModal(); $('#kMsg').textContent = ''; renderKeysDlg(); }
function afterKeysChange(){
  saveKeys(); updateKeysUI(); renderKeyRoute();
  if(S.map) drawOverlay();
}

(function wireKeys(){
  const st = document.createElement('style'); st.textContent = KEY_CSS; document.head.appendChild(st);
  $('#modeSeg').insertAdjacentHTML('beforebegin', '<button id="keysBtn" title="Tell the app which keys you own to plan a key route">My keys</button>');
  $('#route').insertAdjacentHTML('afterend', '<div id="keyroute"></div>');
  $('#fit').insertAdjacentHTML('beforebegin', '<div class="pill"><label><input type="checkbox" id="optQRoute"> Quest route</label><label style="margin-top:4px"><input type="checkbox" id="optKRoute"> Key route</label></div>');
  document.body.insertAdjacentHTML('beforeend',
    '<dialog id="keysDlg"><div class="kh"><h2>My keys</h2><span class="muted" id="kCount"></span></div>' +
    '<p class="muted" style="margin:4px 0 0">Tick the keys you own. The key route visits every door and container they open on the map you are viewing.</p>' +
    '<div class="ktools"><input type="text" id="kq" placeholder="Search keys…" autocomplete="off"><select id="kMapSel" aria-label="Filter by map"></select>' +
    '<label class="muted" style="display:flex;gap:5px;align-items:center"><input type="checkbox" id="kOwned"> only owned</label></div>' +
    '<div class="row" style="margin:0 0 4px"><button id="kNeed" hidden>Add keys my quests need</button><button id="kClear" class="quiet">Clear all</button></div>' +
    '<p class="muted" id="kMsg" style="margin:2px 0"></p><div id="kBody"></div>' +
    '<div class="row" style="justify-content:flex-end;margin-top:0"><button id="kClose" class="primary">Done</button></div></dialog>');
  $('#kMapSel').innerHTML = '<option value="all">All maps</option>' + MAPS.map(m => '<option value="' + m + '">' + esc(MAP_LABEL[m]) + '</option>').join('');
  $('#optQRoute').checked = S.opts.showQuest !== false;
  $('#optKRoute').checked = S.opts.showKeys !== false;
  const redraw = () => { saveOpts(); renderRoute(); renderKeyRoute(); if(S.map) drawOverlay(); };
  $('#optQRoute').addEventListener('change', e => { S.opts.showQuest = e.target.checked; redraw(); });
  $('#optKRoute').addEventListener('change', e => { S.opts.showKeys = e.target.checked; redraw(); });
  $('#keysBtn').addEventListener('click', openKeysDlg);
  $('#kClose').addEventListener('click', () => $('#keysDlg').close());
  $('#kq').addEventListener('input', renderKeysDlg);
  $('#kMapSel').addEventListener('change', e => { kMap = e.target.value; renderKeysDlg(); });
  $('#kOwned').addEventListener('change', e => { kShowOwned = e.target.checked; renderKeysDlg(); });
  $('#kClear').addEventListener('click', () => { if(!S.myKeys.size || !confirm('Remove all keys from your list?')) return; S.myKeys.clear(); afterKeysChange(); renderKeysDlg(); });
  $('#kBody').addEventListener('change', e => {
    const cb = e.target.closest('input[data-k]'); if(!cb) return;
    if(cb.checked) S.myKeys.add(cb.dataset.k); else S.myKeys.delete(cb.dataset.k);
    afterKeysChange();
  });
  $('#kNeed').addEventListener('click', () => {
    const need = neededKeyNames(), byName = new Map(keyIndex().map(e => [norm(e.name), e]));
    let added = 0, miss = 0;
    need.forEach((qs, name) => { const e = byName.get(norm(name)); if(!e) miss++; else if(!S.myKeys.has(e.id)){ S.myKeys.add(e.id); added++; } });
    $('#kMsg').textContent = 'Added ' + added + ' key' + (added === 1 ? '' : 's') + '.' + (miss ? ' ' + miss + ' needed key' + (miss === 1 ? ' has' : 's have') + ' no known door positions, so ' + (miss === 1 ? 'it' : 'they') + ' cannot be routed.' : '') +
      ' Where a quest accepts any of several keys, all of them were added; untick the ones you do not have.';
    afterKeysChange(); renderKeysDlg();
  });
  /* "Zoom to route" fits whichever routes are visible */
  $('#fit').addEventListener('click', () => {
    if(!S.map || !S.an) return;
    const pts = [], a = S.an.A[S.curMap];
    if(S.opts.showQuest !== false && a && a.route){ a.route.stops.forEach(s => pts.push([s.p.z, s.p.x])); if(a.route.exit) pts.push([a.route.exit.e.p.z, a.route.exit.e.p.x]); }
    const kr = S.opts.showKeys !== false ? keyRoute(S.curMap) : null;
    if(kr){ kr.stops.forEach(s => pts.push([s.p.z, s.p.x])); if(kr.exit) pts.push([kr.exit.e.p.z, kr.exit.e.p.x]); }
    if(pts.length) S.map.fitBounds(L.latLngBounds(pts).pad(0.25), { maxZoom:S.fitZoom + 3 });
  });
  /* wrap existing renderers so the quest route can be hidden and the key route added */
  { const _rr = renderRoute;
    renderRoute = function(){
      _rr();
      const box = $('#route');
      if(S.opts.showQuest === false && box){
        box.querySelectorAll('.statline,.steps').forEach(n => n.remove());
        box.insertAdjacentHTML('beforeend', '<div class="listbox muted">Quest route hidden. Turn it back on with “Quest route” on the map.</div>');
      }
      renderKeyRoute();
    }; }
  { const _do = drawOverlay;
    drawOverlay = function(){
      const a = S.an && S.an.A[S.curMap];
      if(a && S.opts.showQuest === false){
        const g = a.groups, r = a.route; a.groups = []; a.route = null;
        try{ _do(); } finally { a.groups = g; a.route = r; }
      } else _do();
      drawKeys();
    }; }
  updateKeysUI();
})();

/* ============ kappa filter ============ */
(function wireKappa(){
  /* quest lookups by id hide non-Kappa quests while the filter is on (everything that lists active quests goes through S.byId.get) */
  let full = S.byId;
  const view = {
    get(id){ const t = full.get(id); return (S.opts.kappaOnly && t && !t.kappa) ? undefined : t; },
    has(id){ return full.has(id); },
    get size(){ return full.size; }
  };
  Object.defineProperty(S, 'byId', { get(){ return view; }, set(m){ full = m; }, configurable:true });

  /* pickers (search, trader list, paste-a-list) only see Kappa quests while the filter is on */
  const withKappa = fn => function(){
    if(!S.opts.kappaOnly) return fn.apply(this, arguments);
    const all = S.tasks; S.tasks = all.filter(t => t.kappa);
    try{ return fn.apply(this, arguments); } finally { S.tasks = all; }
  };
  if(typeof updateSugg0 === 'function') updateSugg0 = withKappa(updateSugg0); else updateSugg = withKappa(updateSugg);
  if(typeof traderGroups === 'function') traderGroups = withKappa(traderGroups);
  matchTask = withKappa(matchTask);

  /* note above the quest list while filtering */
  { const _rq = renderQuests;
    renderQuests = function(){
      _rq();
      if(!S.opts.kappaOnly) return;
      const box = $('#quests'); if(!box) return;
      const kap = new Map(S.tasks.map(t => [t.id, t.kappa]));
      const hidden = [...S.active].filter(id => kap.get(id) === false).length;
      const total = S.tasks.filter(t => t.kappa).length;
      box.insertAdjacentHTML('afterbegin', '<div class="listbox muted">Kappa only: showing the ' + total + ' quests required for Kappa.' +
        (hidden ? ' ' + hidden + ' of your selected quest' + (hidden === 1 ? ' is' : 's are') + ' hidden because ' + (hidden === 1 ? 'it is' : 'they are') + ' not needed for Kappa.' : '') + '</div>');
    }; }

  $('#bulk').insertAdjacentHTML('afterend', '<button id="kappaBtn" title="Hide every quest that is not required for the Kappa container">Kappa only</button>');
  const btn = $('#kappaBtn');
  const sync = () => { const on = !!S.opts.kappaOnly; btn.classList.toggle('primary', on); btn.setAttribute('aria-pressed', String(on)); btn.textContent = on ? 'Kappa only ✓' : 'Kappa only'; };
  btn.addEventListener('click', () => {
    S.opts.kappaOnly = !S.opts.kappaOnly; saveOpts(); sync();
    $('#sugg').hidden = true;
    refresh();
  });
  sync();
})();

/* ============ quest sorting ============ */
(function wireSort(){
  const st = document.createElement('style');
  st.textContent = `
.sortbar{display:flex;align-items:center;gap:8px;padding:8px 14px;border-bottom:1px solid var(--line);background:var(--panel)}
.sortbar label{color:var(--mute);font-size:13px}
.sortbar select{flex:1;min-width:0;background:var(--bg);color:var(--text);border:1px solid var(--line);border-radius:5px;padding:5px 8px}
.sortbar button.on{border-color:var(--accent);color:var(--accent)}
.qgrp{display:flex;justify-content:space-between;padding:6px 14px 4px;background:var(--bg);border-bottom:1px solid var(--line);font:600 15px var(--f-head);letter-spacing:.03em;color:var(--accent);text-transform:uppercase}
.qgrp span{color:var(--mute);font-weight:500}
`;
  document.head.appendChild(st);

  /* carry the experience reward through normalizeTasks */
  { const _nt = normalizeTasks;
    normalizeTasks = function(raw){
      const out = _nt(raw), by = new Map(raw.map(r => [r.id, r]));
      out.forEach(t => { const r = by.get(t.id); t.exp = (r && r.experience) || 0; });
      return out;
    }; }

  const mapOf = t => {
    if(t.map && SVG_FILES[t.map]) return t.map;
    const c = {};
    t.objs.forEach(o => o.maps.forEach(m => { if(SVG_FILES[m]) c[m] = (c[m] || 0) + 1; }));
    return Object.keys(c).sort((a, b) => c[b] - c[a] || a.localeCompare(b))[0] || null;
  };
  const mapLabelOf = t => { const m = mapOf(t); return m ? (MAP_LABEL[m] || m) : 'Any map'; };
  const byName = (a, b) => a.t.name.localeCompare(b.t.name);
  const CMP = {
    added:  (a, b) => a.i - b.i,
    name:   byName,
    trader: (a, b) => (a.t.trader || '').localeCompare(b.t.trader || '') || (a.t.level || 0) - (b.t.level || 0) || byName(a, b),
    map:    (a, b) => {
      const la = mapLabelOf(a.t), lb = mapLabelOf(b.t);
      if((la === 'Any map') !== (lb === 'Any map')) return la === 'Any map' ? 1 : -1;
      return la.localeCompare(lb) || byName(a, b);
    },
    exp:    (a, b) => (b.t.exp || 0) - (a.t.exp || 0) || byName(a, b)
  };

  function applySort(){
    const box = $('#quests'); if(!box) return;
    const mode = CMP[S.opts.sortBy] ? S.opts.sortBy : 'added', rev = !!S.opts.sortRev;
    const ents = [...box.querySelectorAll('.qcard')].map((el, i) => ({ el, i, t:S.byId.get(el.dataset.id) })).filter(e => e.t);
    if(!ents.length) return;
    ents.sort(CMP[mode]); if(rev) ents.reverse();
    const grp = mode === 'trader' ? e => e.t.trader || 'Unknown' : mode === 'map' ? e => mapLabelOf(e.t) : null;
    const counts = new Map();
    if(grp) ents.forEach(e => counts.set(grp(e), (counts.get(grp(e)) || 0) + 1));
    let last = null;
    ents.forEach(e => {
      box.appendChild(e.el);
      if(grp){
        const g = grp(e);
        if(g !== last){ e.el.insertAdjacentHTML('beforebegin', '<div class="qgrp">' + esc(g) + '<span>' + counts.get(g) + '</span></div>'); last = g; }
      }
      if(mode === 'exp'){
        const sm = e.el.querySelector('.qname small');
        if(sm) sm.insertAdjacentHTML('beforeend', ' · ' + (e.t.exp || 0).toLocaleString() + ' XP');
      }
    });
  }
  { const _rq = renderQuests;
    renderQuests = function(){ _rq(); applySort(); }; }

  $('#quests').insertAdjacentHTML('beforebegin',
    '<div class="sortbar"><label for="sortSel">Sort</label><select id="sortSel">' +
    '<option value="added">Order added</option><option value="name">Name A–Z</option><option value="trader">Trader</option>' +
    '<option value="map">Map</option><option value="exp">Experience gained</option></select>' +
    '<button id="sortRev" class="quiet" title="Reverse the order" aria-pressed="false">↕ Reverse</button></div>');
  const sel = $('#sortSel'), rv = $('#sortRev');
  sel.value = CMP[S.opts.sortBy] ? S.opts.sortBy : 'added';
  const syncRev = () => { rv.classList.toggle('on', !!S.opts.sortRev); rv.setAttribute('aria-pressed', String(!!S.opts.sortRev)); };
  syncRev();
  const redo = () => {
    saveOpts();
    const open = [...document.querySelectorAll('.qcard[open]')].map(c => c.dataset.id);
    renderQuests();
    open.forEach(id => { const c = document.querySelector('.qcard[data-id="' + CSS.escape(id) + '"]'); if(c) c.open = true; });
  };
  sel.addEventListener('change', () => { S.opts.sortBy = sel.value; redo(); });
  rv.addEventListener('click', () => { S.opts.sortRev = !S.opts.sortRev; syncRev(); redo(); });
})();

/* ============ undo, completed quests, wiki links ============ */
(function wireExtras(){
  const st = document.createElement('style');
  st.textContent = `
.histbar{display:flex;gap:8px;align-items:center;padding:8px 14px;border-bottom:1px solid var(--line);background:var(--panel)}
.histbar button:disabled{opacity:.4;cursor:default;border-color:var(--line)}
.wikilink{color:var(--accent);font-size:12px;text-decoration:none;white-space:nowrap;margin-left:8px}
.wikilink:hover{text-decoration:underline}
.qwiki{margin:2px 0 6px}
.qwiki .wikilink{margin-left:0}
button.quiet.qdone{color:var(--ok)}
button.quiet.qdone:hover{border-color:var(--ok);color:var(--ok)}
#toast{position:fixed;left:50%;bottom:22px;transform:translateX(-50%);z-index:5000;display:flex;gap:14px;align-items:center;max-width:92vw;background:var(--panel2);border:1px solid var(--accent);border-radius:6px;padding:8px 12px;box-shadow:0 6px 24px #000a}
#toast[hidden]{display:none}
#doneDlg{width:min(700px,94vw)}
#doneDlg[open]{display:flex;flex-direction:column;max-height:88vh}
.done-h{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:6px}
.done-h h2{margin:0}
.done-h input{flex:1;min-width:160px;max-width:280px;background:var(--bg);border:1px solid var(--line);border-radius:5px;padding:6px 10px}
#doneBody{overflow-y:auto;min-height:0;flex:1;margin:8px 0;border:1px solid var(--line);border-radius:5px}
.drow{display:flex;gap:10px;align-items:center;padding:7px 10px;border-bottom:1px solid var(--line)}
.drow:last-child{border-bottom:0}
.drow .dn{flex:1;min-width:0}
.drow .dn small{display:block;color:var(--mute);font-size:12px}
.drow .dx{color:var(--accent);font-size:12px;white-space:nowrap}
`;
  document.head.appendChild(st);

  /* ---- lookups that ignore the Kappa filter ---- */
  let fullKey = null, fullMap = new Map();
  const taskById = id => {
    if(fullKey !== S.tasks){ fullKey = S.tasks; fullMap = new Map(S.tasks.map(t => [t.id, t])); }
    return fullMap.get(id);
  };

  /* ---- wiki links ---- */
  { const _nt = normalizeTasks;
    normalizeTasks = function(raw){
      const out = _nt(raw), by = new Map(raw.map(r => [r.id, r]));
      out.forEach(t => {
        const r = by.get(t.id);
        t.wiki = (r && r.wikiLink) || '';
        if(t.exp == null) t.exp = (r && r.experience) || 0;
      });
      return out;
    }; }
  const wikiUrl = t => t.wiki || ('https://escapefromtarkov.fandom.com/wiki/' + encodeURIComponent(String(t.name).replace(/ /g, '_')));
  const wikiA = (t, text) => '<a class="wikilink" href="' + esc(wikiUrl(t)) + '" target="_blank" rel="noopener" onclick="event.stopPropagation()" title="Open the wiki page for ' + esc(t.name) + '">' + (text || 'Wiki') + ' ↗</a>';

  { const _pf = popupFor;
    popupFor = function(items, extra){
      const el = _pf(items, extra);
      const rows = el.querySelectorAll('.pi');
      items.forEach((it, i) => { if(rows[i]) rows[i].insertAdjacentHTML('beforeend', wikiA(it.t)); });
      return el;
    }; }
  function addRouteWiki(){
    const a = S.an && S.curMap && S.an.A[S.curMap];
    if(!a || !a.route) return;
    document.querySelectorAll('#route .steps li[data-i]').forEach(li => {
      const stop = a.route.stops[+li.dataset.i]; if(!stop) return;
      li.querySelectorAll('.it').forEach((el, j) => { const it = stop.items[j]; if(it) el.insertAdjacentHTML('beforeend', wikiA(it.g.t)); });
    });
  }
  { const _rr = renderRoute;
    renderRoute = function(){ _rr(); addRouteWiki(); }; }

  /* ---- completed quests (saved per game mode) ---- */
  const compAll = (() => { const v = LS.get('rr_completed', {}); return v && typeof v === 'object' && !Array.isArray(v) ? v : {}; })();
  const comp = () => compAll[S.mode] || (compAll[S.mode] = {});
  const saveComp = () => LS.set('rr_completed', compAll);

  /* ---- undo history: snapshot the quest state around every refresh() ---- */
  let last = null, lastSig = '', nextLabel = null;
  const hist = [];
  const snap = () => ({ m:S.mode, a:[...S.active], d:[...S.done], c:Object.assign({}, comp()) });
  const sigOf = s => JSON.stringify([s.m, s.a, s.d.slice().sort(), Object.keys(s.c).sort()]);
  const nm = id => { const t = taskById(id); return t ? '\u201c' + t.name + '\u201d' : 'a quest'; };
  const list = ids => ids.length === 1 ? nm(ids[0]) : ids.length + ' quests';
  function describe(a, b){
    const addC = Object.keys(b.c).filter(id => !(id in a.c)), delC = Object.keys(a.c).filter(id => !(id in b.c));
    const addA = b.a.filter(id => !a.a.includes(id)), delA = a.a.filter(id => !b.a.includes(id));
    if(addC.length) return 'completed ' + list(addC);
    if(delC.length) return 'reopened ' + list(delC);
    if(delA.length) return 'removed ' + list(delA);
    if(addA.length) return 'added ' + list(addA);
    const dd = b.d.length - a.d.length;
    return dd > 0 ? 'ticked an objective' : dd < 0 ? 'unticked an objective' : 'last change';
  }
  { const _rf = refresh;
    refresh = function(){
      const c = comp(); let fix = false;
      S.active.forEach(id => { if(c[id]){ delete c[id]; fix = true; } });   /* a quest you add again is no longer "completed" */
      if(fix) saveComp();
      const cur = snap(), sig = sigOf(cur);
      if(last && last.m !== cur.m) hist.length = 0;
      else if(last && sig !== lastSig){ hist.push({ s:last, label:nextLabel || describe(last, cur) }); if(hist.length > 60) hist.shift(); }
      last = cur; lastSig = sig; nextLabel = null;
      _rf.apply(this, arguments);
      updateHistUI();
    }; }

  const openIds = () => [...document.querySelectorAll('.qcard[open]')].map(c => c.dataset.id);
  const reopenCards = ids => ids.forEach(id => { const c = document.querySelector('.qcard[data-id="' + CSS.escape(id) + '"]'); if(c) c.open = true; });

  let toastTimer = 0;
  function toast(msg, canUndo){
    const el = $('#toast'); if(!el) return;
    el.innerHTML = '<span></span>' + (canUndo ? '<button id="toastUndo">Undo</button>' : '');
    el.firstChild.textContent = msg; el.hidden = false;
    if(canUndo) $('#toastUndo').addEventListener('click', undo);
    clearTimeout(toastTimer); toastTimer = setTimeout(() => { el.hidden = true; }, 7000);
  }
  function undo(){
    const e = hist.pop(); if(!e) return;
    const s = e.s, c = comp(), open = openIds();
    S.active.clear(); s.a.forEach(id => { if(taskById(id)) S.active.add(id); });
    S.done.clear(); s.d.forEach(id => S.done.add(id));
    Object.keys(c).forEach(k => delete c[k]); Object.assign(c, s.c);
    saveActive(); saveComp();
    last = snap(); lastSig = sigOf(last);     /* so refresh() does not record the undo itself */
    refresh(); reopenCards(open);
    toast('Undid: ' + e.label, false);
  }

  /* ---- completing quests ---- */
  const finishQuest = id => { comp()[id] = Date.now(); S.active.delete(id); };
  function completeNow(id){
    const t = taskById(id), open = openIds();
    finishQuest(id); saveActive(); saveComp(); refresh(); reopenCards(open);
    if(t) toast('Completed \u201c' + t.name + '\u201d', true);
  }
  toggleDone = function(oid, val){
    const v = val === undefined ? !S.done.has(oid) : val;
    if(v) S.done.add(oid); else S.done.delete(oid);
    let fin = null;
    if(v){
      const t = [...S.active].map(taskById).find(t => t && t.objs.some(o => o.id === oid));
      if(t){ const req = t.objs.filter(o => !o.optional); if(req.length && req.every(o => S.done.has(o.id))) fin = t; }
    }
    if(fin) finishQuest(fin.id);
    saveActive(); saveComp();
    const open = openIds();
    refresh(); reopenCards(open);
    if(fin) toast('Completed \u201c' + fin.name + '\u201d', true);
  };

  /* ---- completed quests never come back through search or the trader lists ---- */
  const hideDone = fn => function(){
    const done = Object.keys(comp());
    if(!done.length) return fn.apply(this, arguments);
    const real = S.active; S.active = new Set([...real, ...done]);
    try{ return fn.apply(this, arguments); } finally { S.active = real; }
  };
  if(typeof updateSugg0 === 'function') updateSugg0 = hideDone(updateSugg0);
  if(typeof renderTraderBar === 'function'){
    const _tb = renderTraderBar;
    renderTraderBar = hideDone(function(){
      _tb.apply(this, arguments);
      const c = comp();
      document.querySelectorAll('#traderList .trow').forEach(r => { if(c[r.dataset.id]){ const ta = r.querySelector('.ta'); if(ta) ta.textContent = '\u2713 completed'; } });
    });
  }

  /* ---- quest cards: complete button + wiki link ---- */
  function decorateCards(){
    document.querySelectorAll('#quests .qcard').forEach(card => {
      const t = taskById(card.dataset.id); if(!t) return;
      const rm = card.querySelector('.rm');
      if(rm && !card.querySelector('.qdone')){
        const b = document.createElement('button');
        b.className = 'quiet qdone'; b.textContent = '\u2713'; b.title = 'Mark quest completed'; b.setAttribute('aria-label', 'Mark ' + t.name + ' completed');
        b.addEventListener('click', e => { e.preventDefault(); e.stopPropagation(); completeNow(t.id); });
        rm.before(b);
      }
      const objs = card.querySelector('.objs');
      if(objs && !objs.querySelector('.qwiki')) objs.insertAdjacentHTML('afterbegin', '<div class="qwiki">' + wikiA(t, 'Wiki page') + '</div>');
    });
  }
  { const _rq = renderQuests;
    renderQuests = function(){
      if(!last || last.m !== S.mode){ last = snap(); lastSig = sigOf(last); hist.length = 0; }   /* first render, or game mode switched */
      _rq(); decorateCards(); updateHistUI();
    }; }

  /* ---- UI: undo + completed buttons, completed dialog, toast ---- */
  const bar = '<div class="histbar"><button id="undoBtn" disabled>\u21b6 Undo</button><button id="doneBtn" title="Quests you have finished">\u2713 Completed</button></div>';
  const anchor = document.querySelector('.sortbar') || $('#quests');
  anchor.insertAdjacentHTML('beforebegin', bar);
  document.body.insertAdjacentHTML('beforeend',
    '<dialog id="doneDlg"><div class="done-h"><h2>Completed quests</h2><input id="doneQ" type="search" placeholder="Filter by name or trader" autocomplete="off"></div>' +
    '<p class="muted" id="doneSub" style="margin:0"></p><div id="doneBody"></div>' +
    '<div class="row" style="justify-content:space-between;margin-top:0"><button id="doneClear" class="quiet">Clear history</button><button id="doneClose" class="primary">Close</button></div></dialog>' +
    '<div id="toast" role="status" hidden></div>');

  function updateHistUI(){
    const u = $('#undoBtn'), d = $('#doneBtn'); if(!u || !d) return;
    const top = hist[hist.length - 1];
    u.disabled = !top; u.title = top ? 'Undo: ' + top.label + ' (Ctrl+Z)' : 'Nothing to undo';
    const n = Object.keys(comp()).filter(taskById).length;
    d.textContent = '\u2713 Completed' + (n ? ' (' + n + ')' : '');
    if($('#doneDlg').open) renderDone();
  }
  function renderDone(){
    const c = comp(), q = norm($('#doneQ').value), words = q ? q.split(' ') : [];
    const all = Object.keys(c).map(id => ({ t:taskById(id), ts:c[id] })).filter(r => r.t);
    const rows = all.filter(r => words.every(w => norm(r.t.name + ' ' + r.t.trader).includes(w))).sort((a, b) => b.ts - a.ts);
    const xp = all.reduce((s, r) => s + (r.t.exp || 0), 0);
    const kTot = S.tasks.filter(t => t.kappa).length, kDone = all.filter(r => r.t.kappa).length;
    $('#doneSub').textContent = all.length ? all.length + ' completed \u00b7 ' + xp.toLocaleString() + ' XP \u00b7 Kappa quests: ' + kDone + ' of ' + kTot : '';
    $('#doneBody').innerHTML = rows.length ? rows.map(r =>
      '<div class="drow" data-id="' + esc(r.t.id) + '">' + avatarHTML(r.t.traderId || r.t.trader, 30) +
      '<span class="dn"><b>' + esc(r.t.name) + '</b><small>' + esc(r.t.trader) + (r.t.level ? ' \u00b7 level ' + r.t.level : '') + ' \u00b7 ' +
      esc(new Date(r.ts).toLocaleString([], { dateStyle:'medium', timeStyle:'short' })) + '</small></span>' +
      ((r.t.exp || 0) ? '<span class="dx">' + r.t.exp.toLocaleString() + ' XP</span>' : '') + wikiA(r.t) +
      '<button class="reopen" title="Put this quest back in your active list">Reopen</button></div>').join('')
      : '<div class="empty"><b>' + (all.length ? 'No matches' : 'Nothing completed yet') + '</b>' +
        (all.length ? 'Try a different search.' : 'Quests you complete are saved here. Use the \u2713 button on a quest, or tick its last objective.') + '</div>';
  }

  $('#undoBtn').addEventListener('click', undo);
  $('#doneBtn').addEventListener('click', () => { $('#doneQ').value = ''; $('#doneDlg').showModal(); renderDone(); });
  $('#doneClose').addEventListener('click', () => $('#doneDlg').close());
  $('#doneQ').addEventListener('input', renderDone);
  $('#doneClear').addEventListener('click', () => {
    if(!Object.keys(comp()).length || !confirm('Clear your completed-quest history?')) return;
    const c = comp(); Object.keys(c).forEach(k => delete c[k]);
    saveComp(); nextLabel = 'cleared completed history'; refresh();
  });
  $('#doneBody').addEventListener('click', e => {
    const b = e.target.closest('button.reopen'); if(!b) return;
    const id = b.closest('.drow').dataset.id;
    delete comp()[id]; S.active.add(id); saveActive(); saveComp(); refresh();
  });
  document.addEventListener('keydown', e => {
    if(!(e.ctrlKey || e.metaKey) || e.shiftKey || e.altKey || e.key.toLowerCase() !== 'z') return;
    if(/^(INPUT|TEXTAREA|SELECT)$/.test((e.target && e.target.tagName) || '') || document.querySelector('dialog[open]')) return;
    e.preventDefault(); undo();
  });
  updateHistUI();
})();

/* ============ legend: PMC spawns, boss spawns, extracts ============ */
(function wireLegend(){
  const st = document.createElement('style');
  st.textContent = `
#legend{min-width:210px;max-width:260px;padding:0}
#legend>summary{list-style:none;cursor:pointer;padding:6px 10px;font:600 15px var(--f-head);letter-spacing:.04em;text-transform:uppercase}
#legend>summary::-webkit-details-marker{display:none}
#legend>summary::after{content:' \u25be';color:var(--mute)}
#legend:not([open])>summary::after{content:' \u25b8'}
#legend .lgb{padding:0 10px 8px;display:flex;flex-direction:column;gap:6px}
#legend .lgr{display:flex;gap:7px;align-items:center;cursor:pointer}
#legend .lgr .cnt{margin-left:auto;color:var(--mute);font-size:12px;white-space:nowrap}
#legend .lgr.dis{opacity:.55;cursor:default}
#legend small{display:block;color:var(--mute);font-size:12px;line-height:1.3;margin:0 0 0 21px}
#legend .sw{flex:none;width:16px;display:inline-flex;justify-content:center;align-items:center;gap:2px}
#legend .sw i.d{display:block;width:8px;height:8px;transform:rotate(45deg);border:1.5px solid #fff;box-shadow:0 0 0 1px #000}
#legend .sw i.d.pmc{background:#58c47a}#legend .sw i.d.scav{background:#5ba3e0}#legend .sw i.d.shared{background:#e0a24a}
#legend .sw i.dot{display:block;width:9px;height:9px;border-radius:50%;background:#e9e4d4;border:1px solid #0b1210}
#legend .sw i.sk{display:grid;place-items:center;width:15px;height:15px;border-radius:50%;background:#c0352b;border:1.5px solid #fff;box-shadow:0 0 0 1px #000;color:#fff;font:normal 9px/1 var(--f-body)}
#legend .sw i.d.transit{background:#b57be0;border-radius:50%;transform:none}
#lgEx{display:flex;flex-direction:column;gap:5px;margin:-2px 0 0 21px}
.extx{background:none;border:0}
.extx .dm{position:absolute;left:0;top:0;display:block;width:13px;height:13px;transform:rotate(45deg);border:2px solid #fff;box-shadow:0 0 0 1px #000}
.extx.pmc .dm{background:#58c47a}.extx.scav .dm{background:#5ba3e0}.extx.shared .dm{background:#e0a24a}
.extx.transit .dm{background:#b57be0;border-radius:50%;transform:none}
.extx .xl{position:absolute;left:24px;top:50%;transform:translateY(-50%);white-space:nowrap;pointer-events:none;background:rgba(10,16,14,.6);color:#e9e4d4;font:600 10px/1.1 var(--f-body);letter-spacing:.02em;padding:1px 4px;border-radius:3px}
#lgBosses{display:flex;flex-direction:column;gap:5px;max-height:34vh;overflow-y:auto;padding-left:0;margin-top:2px;border-top:1px solid var(--line);padding-top:6px}
#lgBosses:empty{display:none}
.bossm{background:none;border:0}
.bossm span{display:grid;place-items:center;width:22px;height:22px;border-radius:50%;background:#c0352b;border:2px solid #fff;box-shadow:0 0 0 1px #000;color:#fff;font-size:12px;line-height:1}
`;
  document.head.appendChild(st);

  /* ---- data: spawns and bosses per map (day/night factory etc. are merged like the extracts) ---- */
  S.spawns = {}; S.bosses = {};
  { const _ne = normalizeExtracts;
    normalizeExtracts = function(raw){
      S.spawns = {}; S.bosses = {};
      (raw || []).forEach(m => {
        const k = canon(m.normalizedName); if(!k || !SVG_FILES[k]) return;
        const sa = S.spawns[k] = S.spawns[k] || [];
        (m.spawns || []).forEach(p => { if(p && p.x != null && !sa.some(a => Math.abs(a.x - p.x) < 1 && Math.abs(a.z - p.z) < 1)) sa.push({ x:p.x, y:p.y || 0, z:p.z }); });
        const variant = /night/.test(m.normalizedName || '') ? 'night raid' : /-21$/.test(m.normalizedName || '') ? 'level 21+' : '';
        const ba = S.bosses[k] = S.bosses[k] || [];
        (m.bosses || []).forEach(b => ba.push(Object.assign({}, b, { variant })));
      });
      return _ne(raw);
    }; }

  const pct = c => c == null ? '' : Math.round(c * 100) + '%';
  const hidden = () => S.opts.hideBoss || (S.opts.hideBoss = {});
  const on = key => S.opts[key] !== false;

  /* ---- drawing ---- */
  function drawLayers(k){
    if(on('showSpawns')) (S.spawns[k] || []).forEach(p => {
      L.circleMarker([p.z, p.x], { radius:4, color:'#0b1210', weight:1, fillColor:'#e9e4d4', fillOpacity:.9 })
        .bindTooltip('PMC spawn').addTo(S.layer).bringToBack();
    });
    if(on('showBosses')){
      /* entries that share the same spawn points form one zone; big zones get one marker plus an outline */
      const zones = new Map();
      (S.bosses[k] || []).forEach(b => {
        if(hidden()[b.mob] || !(b.positions || []).length) return;
        const sig = b.positions.map(p => Math.round(p.x) + ',' + Math.round(p.z)).sort().join(';');
        if(!zones.has(sig)) zones.set(sig, { pos:b.positions, list:[] });
        zones.get(sig).list.push(b);
      });
      const hull = pts => {
        const P = pts.map(p => [p.x, p.z]).sort((a, c) => a[0] - c[0] || a[1] - c[1]);
        if(P.length < 3) return P;
        const cr = (o, a, c) => (a[0] - o[0]) * (c[1] - o[1]) - (a[1] - o[1]) * (c[0] - o[0]);
        const lo = [], up = [];
        P.forEach(p => { while(lo.length > 1 && cr(lo[lo.length - 2], lo[lo.length - 1], p) <= 0) lo.pop(); lo.push(p); });
        [...P].reverse().forEach(p => { while(up.length > 1 && cr(up[up.length - 2], up[up.length - 1], p) <= 0) up.pop(); up.push(p); });
        return lo.slice(0, -1).concat(up.slice(0, -1));
      };
      zones.forEach(z => {
        const seen = new Set(), rows = [];
        z.list.forEach(b => {
          const line = '<div class="pi"><b>' + esc(b.name) + (b.variant ? ' <span class="muted">(' + esc(b.variant) + ')</span>' : '') + '</b>' +
            (b.chance != null ? pct(b.chance) + ' spawn chance' : '') + (b.zone ? ' \u00b7 ' + esc(b.zone) + (b.zoneChance != null && b.zoneChance < 1 ? ' (' + pct(b.zoneChance) + ' of spawns)' : '') : '') + '</div>';
          if(!seen.has(line)){ seen.add(line); rows.push(line); }
        });
        const names = [...new Set(z.list.map(b => b.name))].join(', ');
        const big = z.pos.length > 3;
        const head = '<b>Boss spawn' + (big ? ' area' : '') + '</b>' + (big ? '<div class="muted">' + z.pos.length + ' possible spawn points</div>' : '');
        const at = big ? cent(z.pos) : null;
        if(big){
          const h = hull(z.pos);
          if(h.length > 2) L.polygon(h.map(q => [q[1], q[0]]), { color:'#e8453c', weight:1.5, dashArray:'5 4', opacity:.85, fillOpacity:.08, interactive:false }).addTo(S.layer).bringToBack();
        }
        (big ? [at] : z.pos).forEach(p =>
          L.marker([p.z, p.x], { icon:L.divIcon({ className:'bossm', html:'<span>\u2620</span>', iconSize:[22,22] }), zIndexOffset:-300 })
            .bindTooltip(names).bindPopup('<div class="pop">' + head + rows.join('') + '</div>').addTo(S.layer));
      });
    }
  }
  /* ---- extracts: PMC / Scav / transit toggles; the name is part of the marker so it always stays ---- */
  const exOn = key => S.opts[key] === undefined
    ? (key === 'showScavEx' ? S.opts.faction === 'scav' : key === 'showPmcEx' ? S.opts.faction !== 'scav' : true)
    : S.opts[key] !== false;
  const exShown = e => e.faction === 'pmc' ? exOn('showPmcEx') : e.faction === 'scav' ? exOn('showScavEx')
    : e.faction === 'transit' ? exOn('showTransit') : (exOn('showPmcEx') || exOn('showScavEx'));      /* shared = open to both */
  const EX_KIND = { pmc:'PMC exit', scav:'Scav exit', shared:'Shared exit (PMC and Scav)', transit:'Transit to another map' };
  function drawExtracts(k){
    const old = [];
    S.layer.eachLayer(l => { const ic = l instanceof L.Marker && l.options && l.options.icon; if(ic && /^ext\b/.test(ic.options.className || '')) old.push(l); });
    old.forEach(l => S.layer.removeLayer(l));
    if(!S.opts.extracts) return;
    (S.extracts[k] || []).filter(exShown).forEach(e =>
      L.marker([e.p.z, e.p.x], { icon:L.divIcon({ className:'extx ' + e.faction, html:'<i class="dm"></i><b class="xl">' + esc(e.name) + '</b>', iconSize:[16, 16] }), zIndexOffset:-500 })
        .bindPopup('<div class="pop"><b>' + esc(e.name) + '</b>' + (EX_KIND[e.faction] || '') + '</div>').addTo(S.layer));
  }
  { const _do = drawOverlay;
    drawOverlay = function(){
      _do();
      if(S.map && S.layer){ drawExtracts(S.curMap); drawLayers(S.curMap); }
      renderLegend();
    }; }

  /* ---- legend UI ---- */
  $('#viewtools').insertAdjacentHTML('afterbegin',
    '<details class="pill" id="legend" open><summary>Legend</summary><div class="lgb">' +
    '<label class="lgr"><input type="checkbox" data-l="extracts"><span class="sw"><i class="d pmc"></i><i class="d scav"></i><i class="d transit"></i></span>Extracts</label>' +
    '<div id="lgEx">' +
    '<label class="lgr"><input type="checkbox" data-l="showPmcEx"><span class="sw"><i class="d pmc"></i></span>PMC exits<span class="cnt" id="lgPmcCnt"></span></label>' +
    '<label class="lgr"><input type="checkbox" data-l="showScavEx"><span class="sw"><i class="d scav"></i></span>Scav exits<span class="cnt" id="lgScavCnt"></span></label>' +
    '<label class="lgr"><input type="checkbox" data-l="showTransit"><span class="sw"><i class="d transit"></i></span>Transits<span class="cnt" id="lgTrCnt"></span></label>' +
    '<small>Orange exits are open to both and show with PMC or Scav. Switching "Spawn as" resets PMC / Scav.</small></div>' +
    '<label class="lgr"><input type="checkbox" data-l="showSpawns"><span class="sw"><i class="dot"></i></span>PMC spawns<span class="cnt" id="lgSpawnCnt"></span></label>' +
    '<label class="lgr"><input type="checkbox" data-l="showBosses"><span class="sw"><i class="sk">\u2620</i></span>Boss spawns<span class="cnt" id="lgBossCnt"></span></label>' +
    '<div id="lgBosses"></div></div></details>');
  { const old = $('#optExt'); if(old && old.closest('label')) old.closest('label').style.display = 'none'; }

  function renderLegend(){
    const lg = $('#legend'); if(!lg) return;
    const k = S.curMap, sp = (S.spawns && S.spawns[k]) || [], bs = (S.bosses && S.bosses[k]) || [];
    lg.querySelector('[data-l="extracts"]').checked = !!S.opts.extracts;
    ['showPmcEx', 'showScavEx', 'showTransit'].forEach(key => { const cb = lg.querySelector('[data-l="' + key + '"]'); if(cb) cb.checked = exOn(key); });
    const ec = { pmc:0, scav:0, shared:0, transit:0 };
    (S.extracts[k] || []).forEach(e => { if(e.faction in ec) ec[e.faction]++; });
    $('#lgPmcCnt').textContent = (ec.pmc + ec.shared) || '';
    $('#lgScavCnt').textContent = (ec.scav + ec.shared) || '';
    $('#lgTrCnt').textContent = ec.transit || '';
    lg.querySelector('[data-l="showSpawns"]').checked = on('showSpawns');
    lg.querySelector('[data-l="showBosses"]').checked = on('showBosses');
    $('#lgSpawnCnt').textContent = sp.length || '';
    const g = new Map();
    bs.forEach(b => {
      if(!g.has(b.mob)) g.set(b.mob, { mob:b.mob, name:b.name, chances:new Set(), zones:new Set(), pos:0, variants:new Set() });
      const r = g.get(b.mob);
      if(b.chance != null) r.chances.add(b.chance);
      if(b.zone) r.zones.add(b.zone);
      if(b.variant) r.variants.add(b.variant);
      r.pos += (b.positions || []).length;
    });
    $('#lgBossCnt').textContent = g.size || '';
    const fm = document.activeElement && document.activeElement.dataset && document.activeElement.dataset.boss;
    $('#lgBosses').innerHTML = [...g.values()].sort((a, b) => Math.max(...b.chances) - Math.max(...a.chances) || a.name.localeCompare(b.name)).map(r => {
      const ch = [...r.chances].sort((a, b) => b - a).map(pct).join(' / ');
      const none = !r.pos;
      return '<div><label class="lgr ' + (none ? 'dis' : '') + '" title="' + (none ? 'No fixed spawn point on the map for this boss' : 'Show or hide ' + esc(r.name)) + '">' +
        '<input type="checkbox" data-boss="' + esc(r.mob) + '" ' + (none || hidden()[r.mob] ? '' : 'checked') + ' ' + (none ? 'disabled' : '') + '>' +
        '<span><b>' + esc(r.name) + '</b></span><span class="cnt">' + esc(ch) + '</span></label>' +
        '<small>' + esc([...r.zones].join(', ')) + (r.variants.size ? ' \u00b7 ' + esc([...r.variants].join(', ')) : '') + (none ? ' \u00b7 no map position' : '') + '</small></div>';
    }).join('');
    if(fm){ const el = lg.querySelector('[data-boss="' + CSS.escape(fm) + '"]'); if(el) el.focus(); }
  }
  $('#legend').addEventListener('change', e => {
    const t = e.target; if(!t || t.type !== 'checkbox') return;
    if(t.dataset.boss){ if(t.checked) delete hidden()[t.dataset.boss]; else hidden()[t.dataset.boss] = true; }
    else if(t.dataset.l === 'extracts'){ S.opts.extracts = t.checked; const o = $('#optExt'); if(o) o.checked = t.checked; }
    else if(t.dataset.l){ S.opts[t.dataset.l] = t.checked; }
    saveOpts();
    if(S.map) drawOverlay(); else renderLegend();
  });
  $('#optFac').addEventListener('change', e => { const sc = e.target.value === 'scav'; S.opts.showPmcEx = !sc; S.opts.showScavEx = sc; });
  renderLegend();
})();

/* ============ item photos + loot spawns (rare items, keys) ============ */
function itemIconUrl(id){
  const e = (typeof EMBEDDED_ICONS !== 'undefined' && EMBEDDED_ICONS) || null;
  return (e && e[id]) || ('https://assets.tarkov.dev/' + id + '-icon.webp');
}
function itemImg(id, px){
  px = px || 24;
  return '<img class="ii" src="' + esc(itemIconUrl(id)) + '" alt="" width="' + px + '" height="' + px + '" loading="lazy" onerror="this.remove()">';
}
(function wireLoot(){
  const st = document.createElement('style');
  st.textContent = `
img.ii{object-fit:contain;background:#2a2d28;border:1px solid #0007;border-radius:3px;flex:none;vertical-align:middle}
.lootm{background:none;border:0}
.lootm span{display:grid;place-items:center;width:18px;height:18px;color:#10130f;font:700 11px/1 var(--f-body);border:1.5px solid #0b1210;box-shadow:0 0 0 1px #000a}
.lootm.rare span{background:#f2c14e;border-radius:50%;font-size:12px}
.lootm.hv span{background:#e0568f;border-radius:4px;color:#fff}
.lootm.quest span{background:#8b6fd6;border-radius:4px;color:#fff}
.lootm.other span{background:#8a9a94;border-radius:4px}
.lootm.need span{box-shadow:0 0 0 2px #4fd1e0,0 0 0 3px #000}
.lootpop{max-width:280px}
.lootpop .lg{margin:6px 0 2px;font-size:11px;letter-spacing:.05em;text-transform:uppercase;opacity:.7}
.lootpop .lti{display:flex;gap:6px;align-items:center;margin:2px 0;font-size:12px}
.lootpop .lti em{color:#0f7c8a;font-style:normal;font-size:11px}
.lootpop .note{font-size:11px;opacity:.7;margin-top:6px}
#legend{max-height:78vh;overflow-y:auto}
#legend .sw i.lt{display:grid;place-items:center;width:15px;height:15px;color:#10130f;font:700 10px/1 var(--f-body);border:1.5px solid #0b1210;box-shadow:0 0 0 1px #000a}
#legend .sw i.lt.rare{background:#f2c14e;border-radius:50%}
#legend .sw i.lt.hv{background:#e0568f;border-radius:3px;color:#fff}
#legend .sw i.lt.quest{background:#8b6fd6;border-radius:3px;color:#fff}
#legend .sw i.lt.other{background:#8a9a94;border-radius:3px}
#lgLoot{display:flex;flex-direction:column;gap:6px;margin-top:2px;border-top:1px solid var(--line);padding-top:6px}
#lgRareList{margin:-2px 0 0 21px}
#lgRareList>summary{cursor:pointer;color:var(--mute);font-size:12px}
#lgRareItems{display:flex;flex-direction:column;gap:3px;max-height:26vh;overflow-y:auto;margin-top:4px}
#lgRareItems .lgr{font-size:12px;gap:5px}
#lgRareItems .lgbtns{display:flex;gap:6px}
#lgRareItems .lgbtns button{padding:1px 8px;font-size:11px}
`;
  document.head.appendChild(st);

  /* ---- data: loot spawn points per map (day/night etc. merged like the extracts) ---- */
  S.loot = {}; S.lootItems = {};
  { const _ne = normalizeExtracts;
    normalizeExtracts = function(raw){
      S.loot = {}; S.lootItems = {};
      (raw || []).forEach(m => {
        const k = canon(m.normalizedName); if(!k || !SVG_FILES[k]) return;
        const arr = S.loot[k] = S.loot[k] || [];
        Object.assign(S.lootItems[k] = S.lootItems[k] || {}, m.lootItems || {});
        (m.loot || []).forEach(p => {
          if(p.x == null || p.z == null) return;
          const hit = arr.find(a => Math.abs(a.x - p.x) < 1 && Math.abs(a.z - p.z) < 1);
          if(hit) (p.i || []).forEach(i => { if(!hit.i.includes(i)) hit.i.push(i); });
          else arr.push({ x:p.x, y:p.y || 0, z:p.z, i:(p.i || []).slice() });
        });
      });
      return _ne(raw);
    }; }

  /* ---- categories: rare | hv (high-value key) | quest (key some quest needs) | other (key) ---- */
  const PRI = ['rare', 'hv', 'quest', 'other'];
  const OPT = { rare:'showRare', hv:'showHV', quest:'showQKeys', other:'showOKeys' };
  const LABEL = { rare:'Rare items', hv:'High-value keys', quest:'Quest keys', other:'Other keys' };
  const optOn = c => c === 'other' ? S.opts.showOKeys === true : S.opts[OPT[c]] !== false;
  const hiddenRare = () => S.opts.hideRare || (S.opts.hideRare = {});
  const catsOf = e => !e ? [] : e.c === 'rare' ? ['rare'] : e.c === 'hv' ? (e.q ? ['hv', 'quest'] : ['hv']) : (e.q ? ['quest'] : ['other']);
  /* the one category an item is listed under (first enabled one, in the order above) */
  const catOf = (id, meta) => {
    const e = meta[id]; if(!e) return null;
    if(e.c === 'rare' && hiddenRare()[id]) return null;
    const cs = catsOf(e); return PRI.find(c => cs.includes(c) && optOn(c)) || null;
  };

  function drawLoot(k){
    const meta = S.lootItems[k] || {};
    const need = typeof neededKeyNames === 'function' ? neededKeyNames() : new Map();
    (S.loot[k] || []).forEach(p => {
      const groups = {};
      p.i.forEach(id => { const c = catOf(id, meta); if(c) (groups[c] = groups[c] || []).push(id); });
      const top = PRI.find(c => groups[c]); if(!top) return;
      const wanted = [].concat(...PRI.map(c => groups[c] || [])).filter(id => meta[id].c !== 'rare' && need.has(meta[id].n));
      const glyph = top === 'rare' ? '\u2605' : top === 'other' ? 'k' : 'K';
      const el = document.createElement('div'); el.className = 'pop lootpop';
      let h = '<b>' + (top === 'rare' ? 'Rare item spawn' : 'Key spawn') + '</b>';
      PRI.forEach(c => {
        const ids = groups[c]; if(!ids) return;
        h += '<div class="lg">' + LABEL[c] + ' (' + ids.length + ')</div>' +
          ids.slice(0, 12).map(id => '<div class="lti">' + itemImg(id, 28) + '<span>' + esc(meta[id].n) +
            (need.has(meta[id].n) && c !== 'rare' ? ' <em>needed for your quests</em>' : '') + '</span></div>').join('') +
          (ids.length > 12 ? '<div class="lti"><span>+ ' + (ids.length - 12) + ' more</span></div>' : '');
      });
      h += '<div class="note">One spot in the loose-loot pool: any of these can spawn here, none is guaranteed.</div>';
      el.innerHTML = h;
      const all = [].concat(...PRI.map(c => groups[c] || []));
      const tip = all.slice(0, 3).map(id => meta[id].n).join(', ') + (all.length > 3 ? ' +' + (all.length - 3) + ' more' : '');
      L.marker([p.z, p.x], { icon:L.divIcon({ className:'lootm ' + top + (wanted.length ? ' need' : ''), html:'<span>' + glyph + '</span>', iconSize:[18, 18] }), zIndexOffset:-200 })
        .bindTooltip(tip).bindPopup(el).addTo(S.layer);
    });
  }

  /* ---- legend rows ---- */
  $('#lgBosses').insertAdjacentHTML('beforebegin',
    '<div id="lgLoot" title="Loose-loot spawn points only: keys can also be in containers or on Scavs. A cyan ring marks keys your active quests need.">' +
    '<label class="lgr"><input type="checkbox" data-l="showRare"><span class="sw"><i class="lt rare">\u2605</i></span>Rare items<span class="cnt" id="lgRareCnt"></span></label>' +
    '<details id="lgRareList"><summary>Choose which rare items</summary><div id="lgRareItems"></div></details>' +
    '<label class="lgr"><input type="checkbox" data-l="showHV"><span class="sw"><i class="lt hv">K</i></span>High-value keys<span class="cnt" id="lgHVCnt"></span></label>' +
    '<label class="lgr"><input type="checkbox" data-l="showQKeys"><span class="sw"><i class="lt quest">K</i></span>Quest keys<span class="cnt" id="lgQCnt"></span></label>' +
    '<label class="lgr"><input type="checkbox" data-l="showOKeys"><span class="sw"><i class="lt other">k</i></span>Other keys<span class="cnt" id="lgOCnt"></span></label>' +
    '</div>');

  function renderLootLegend(){
    const lg = $('#legend'); if(!lg || !$('#lgLoot')) return;
    const k = S.curMap, pts = S.loot[k] || [], meta = S.lootItems[k] || {};
    PRI.forEach(c => { const cb = lg.querySelector('[data-l="' + OPT[c] + '"]'); if(cb) cb.checked = optOn(c); });
    const cnt = { rare:0, hv:0, quest:0, other:0 }, rare = new Map();
    pts.forEach(p => {
      const seen = new Set();
      p.i.forEach(id => {
        const e = meta[id]; if(!e) return;
        catsOf(e).forEach(c => seen.add(c));
        if(e.c === 'rare') rare.set(id, (rare.get(id) || 0) + 1);
      });
      seen.forEach(c => cnt[c]++);
    });
    $('#lgRareCnt').textContent = cnt.rare || '';
    $('#lgHVCnt').textContent = cnt.hv || '';
    $('#lgQCnt').textContent = cnt.quest || '';
    $('#lgOCnt').textContent = cnt.other || '';
    const hid = hiddenRare();
    $('#lgRareItems').innerHTML = rare.size
      ? '<div class="lgbtns"><button class="quiet" data-all="1">All</button><button class="quiet" data-all="0">None</button></div>' +
        [...rare.entries()].sort((a, b) => meta[a[0]].n.localeCompare(meta[b[0]].n)).map(([id, n]) =>
          '<label class="lgr"><input type="checkbox" data-loot="' + esc(id) + '" ' + (hid[id] ? '' : 'checked') + '>' + itemImg(id, 20) +
          '<span>' + esc(meta[id].n) + '</span><span class="cnt">' + n + '</span></label>').join('')
      : '<span class="muted" style="font-size:12px">No rare item spawns on this map.</span>';
  }

  { const _do = drawOverlay;
    drawOverlay = function(){
      _do();
      if(S.map && S.layer) drawLoot(S.curMap);
      renderLootLegend();
    }; }

  /* per-item filter (capture phase so the choice is stored before the legend redraws the map) */
  $('#legend').addEventListener('change', e => {
    const t = e.target; if(!t || !t.dataset || !t.dataset.loot) return;
    if(t.checked) delete hiddenRare()[t.dataset.loot]; else hiddenRare()[t.dataset.loot] = true;
  }, true);
  $('#lgRareItems').addEventListener('click', e => {
    const b = e.target.closest('button[data-all]'); if(!b) return;
    const meta = S.lootItems[S.curMap] || {}, hid = hiddenRare();
    Object.keys(meta).forEach(id => { if(meta[id].c === 'rare'){ if(b.dataset.all === '1') delete hid[id]; else hid[id] = true; } });
    saveOpts();
    if(S.map) drawOverlay(); else renderLootLegend();
  });
  renderLootLegend();
})();

/* ============ polish: extract labels, item info in routes ============ */
(function wirePolish(){
  const st = document.createElement('style');
  st.textContent = `
.rq{display:flex;flex-wrap:wrap;align-items:center;gap:4px;margin:3px 0 1px;font-size:12px;line-height:1.25;color:inherit}
.rq .rv{font-weight:600;opacity:.8;margin-right:1px}
.rq .rn{min-width:0}
.pop .fir{color:#8a6d1c;border-color:#8a6d1c}
`;
  document.head.appendChild(st);

  /* ---- what to find / hand in / bring / unlock for an objective, with photos ---- */
  const row = (verb, ns, ids, count, extra) => {
    const label = ns.slice(0, 3).join(' / ') + (ns.length > 3 ? ' / +' + (ns.length - 3) + ' more' : '');
    return '<div class="rq" title="' + esc(ns.join(' / ')) + '"><span class="rv">' + esc(verb) + '</span>' +
      (ids || []).slice(0, 3).map(id => itemImg(id, 26)).join('') +
      '<span class="rn">' + (count ? '<b>' + count + '\u00d7</b> ' : '') + esc(label) + '</span>' + (extra || '') + '</div>';
  };
  function reqHTML(o){
    const q = o && o.req; if(!q) return '';
    let h = '';
    (q.find || []).forEach(f => {
      const verb = f.note === 'hand in' ? 'Hand in' : f.note === 'quest item' ? 'Find quest item' : 'Find';
      h += row(verb, f.names, f.ids, f.count || 1,
        (f.fir ? '<span class="fir">FIR</span>' : '') + (f.extra ? ' <span class="muted">(' + esc(f.extra) + ')</span>' : ''));
    });
    (q.bring || []).forEach(b => {
      h += row('Bring ' + b.note, b.names, b.ids, b.count || 1, b.fir ? '<span class="fir">FIR</span>' : '');
    });
    (q.keys || []).forEach((g, i) => {
      const km = (q.keyMaps || [])[i];
      if(km && km.length && S.curMap && !km.includes(S.curMap)) return;      /* key opens nothing on this map */
      h += row('Key', g, (q.keyIds || [])[i], 0, '');
    });
    return h;
  }

  { const _pf = popupFor;
    popupFor = function(items, extra){
      const el = _pf(items, extra);
      const rows = el.querySelectorAll('.pi');
      items.forEach((it, i) => {
        const h = reqHTML(it.o); if(!h || !rows[i]) return;
        const b = rows[i].querySelector('button');
        if(b) b.insertAdjacentHTML('beforebegin', h); else rows[i].insertAdjacentHTML('beforeend', h);
      });
      return el;
    }; }

  function addRouteReqs(){
    const an = S.an, k = S.curMap, a = an && k && an.A[k];
    if(!a) return;
    if(a.route) document.querySelectorAll('#route .steps li[data-i]').forEach(li => {
      const stop = a.route.stops[+li.dataset.i]; if(!stop) return;
      li.querySelectorAll('.it').forEach((el, j) => {
        const it = stop.items[j];
        if(it && !el.querySelector('.rq')) el.insertAdjacentHTML('beforeend', reqHTML(it.g.o));
      });
    });
    document.querySelectorAll('#route .listbox').forEach(lb => {
      const h = lb.querySelector('h3'); if(!h) return;
      const t = h.textContent;
      const list = t === 'Any map (found in raid)' ? an.flex : t === 'Anywhere on ' + (MAP_LABEL[k] || k) ? a.anywhere : null;
      if(list){
        [...lb.children].filter(c => c.tagName === 'DIV').forEach((r, i) => {
          if(list[i] && !r.querySelector('.rq')) r.insertAdjacentHTML('beforeend', reqHTML(list[i].o));
        });
      } else if(t === 'Hand-ins and other'){
        const d = lb.querySelector('.muted');
        if(d && !d.dataset.rq){
          d.dataset.rq = '1'; d.classList.remove('muted');
          d.innerHTML = an.turnin.map(x => '<div style="margin:4px 0"><b>' + esc(x.t.name) + '</b> \u2014 ' + esc(x.o.desc) + reqHTML(x.o) + '</div>').join('');
        }
      }
    });
  }
  { const _rr = renderRoute;
    renderRoute = function(){ _rr(); addRouteReqs(); }; }
})();

/* ============ accuracy fixes ============ */
(function wireFixes(){
  /* Arena objectives have no map and are not done in a raid */
  { const _nt = normalizeTasks;
    normalizeTasks = function(raw){
      const out = _nt(raw);
      out.forEach(t => {
        if(!/\[PVP ZONE\]/i.test(t.name)) return;
        /* only the objectives that are played in Arena (some [PVP ZONE] quests are ordinary raid kills) */
        t.objs.forEach(o => { if(!o.maps.size && /\bArena\b|TeamFight|BlastGang|CheckPoint|Last ?Hero|\bmatch(es)?\b/.test(o.desc)){ o.nonmap = true; o.flex = false; } });
      });
      return out;
    }; }

  /* objectives on maps this page has no map for */
  const pretty = k => String(k).split('-').map(w => w ? w[0].toUpperCase() + w.slice(1) : w).join(' ');
  function addOffMap(){
    const box = $('#route'), an = S.an; if(!box || !an || !an.act) return;
    const old = box.querySelector('.offmap'); if(old) old.remove();
    const rows = [];
    an.act.forEach(t => t.objs.forEach(o => {
      if(S.done.has(o.id) || (!S.opts.optional && o.optional) || !o.maps.size) return;
      if([...o.maps].some(m => SVG_FILES[m])) return;
      rows.push('<div style="margin:4px 0"><span class="swatch" style="display:inline-block;background:' + qColor(t) + ';margin-right:6px"></span><b>' + esc(t.name) +
        '</b> \u2014 ' + esc(o.desc) + ' <span class="tag">' + esc([...o.maps].map(pretty).join(', ')) + '</span></div>');
    }));
    if(rows.length) box.insertAdjacentHTML('beforeend',
      '<div class="listbox offmap"><h3>On maps without a map view</h3><div class="muted" style="margin-bottom:4px">No map art for these, so they are listed here instead of on a route.</div>' + rows.join('') + '</div>');
  }
  { const _rr = renderRoute;
    renderRoute = function(){ _rr(); addOffMap(); }; }
})();

/* ============ transits: route stop + quest order ============ */
(function wireTransits(){
  const st = document.createElement('style');
  st.textContent = `
.cont{margin:3px 0 1px;padding:3px 6px;border-left:3px solid #b57be0;background:rgba(181,123,224,.10);font-size:12px;line-height:1.3}
.cont b{font-weight:600}
`;
  document.head.appendChild(st);

  const ALIAS = {};
  Object.keys(MAP_LABEL).forEach(k => { ALIAS[k] = k; ALIAS[MAP_LABEL[k].toLowerCase()] = k; });
  Object.assign(ALIAS, { 'streets of tarkov':'streets-of-tarkov', 'the lab':'the-lab', 'labs':'the-lab', 'terragroup labs':'the-lab', 'ground zero 21+':'ground-zero' });
  const mapFrom = s => ALIAS[String(s || '').trim().toLowerCase()] || null;
  const TRANSIT = /\btransit from (.+?) to (.+?)\s*(?:\(|$)/i;

  /* 1) tag transit objectives; 2) put each quest's objectives in the order they are done */
  function reorder(t){
    const trs = t.objs.filter(o => o.transit);
    if(!trs.length) return;
    const stage = {};
    trs.forEach(o => { stage[o.transit.from] = 0; stage[o.transit.to] = 0; });
    const nMaps = Object.keys(stage).length;
    for(let i = 0; i <= nMaps; i++) trs.forEach(o => { stage[o.transit.to] = Math.max(stage[o.transit.to], stage[o.transit.from] + 1); });
    if(Object.values(stage).some(v => v >= nMaps)) return;                 /* A -> B -> A: no clear order, leave it as the data has it */
    const key = (o, i) => {
      if(o.transit) return { s:stage[o.transit.from], x:1, i };
      let ms = [...o.maps];
      if(!ms.length && !o.nonmap){ const m = /\bon ([A-Za-z' ]+?)\s*(?:\(|$)/.exec(o.desc || ''), k = m && mapFrom(m[1]); if(k) ms = [k]; }   /* "... on Streets of Tarkov" */
      if(ms.length !== 1 || !(ms[0] in stage)) return null;               /* hand-ins, any-map objectives ... keep their place */
      return { s:stage[ms[0]], x:o.type === 'extract' ? 1 : 0, i };
    };
    const ks = t.objs.map(key);
    const slots = ks.map((k, i) => k ? i : -1).filter(i => i >= 0);
    const sorted = slots.map(i => ({ o:t.objs[i], k:ks[i] })).sort((a, b) => a.k.s - b.k.s || a.k.x - b.k.x || a.k.i - b.k.i);
    const out = t.objs.slice();
    slots.forEach((slot, n) => { out[slot] = sorted[n].o; });
    t.objs = out;
  }
  { const _nt = normalizeTasks;
    normalizeTasks = function(raw){
      const out = _nt(raw);
      out.forEach(t => {
        t.objs.forEach(o => {
          if(o.type !== 'extract') return;
          const m = TRANSIT.exec(o.desc || ''); if(!m) return;
          const from = mapFrom(m[1]), to = mapFrom(m[2]); if(!from || !to) return;
          o.transit = { from, to, toLabel:m[2].trim() };
          o.maps = new Set([from]); o.flex = false;                       /* it happens on the map you leave, not on the one you arrive at */
        });
        reorder(t);
      });
      return out;
    }; }

  /* where the transit is: the transit point on the "from" map that leads to the "to" map */
  function resolveTransits(){
    (S.tasks || []).forEach(t => t.objs.forEach(o => {
      const tr = o.transit; if(!tr || (o.pts[tr.from] && o.pts[tr.from].length)) return;
      const ex = ((S.extracts && S.extracts[tr.from]) || []).filter(e => e.faction === 'transit');
      const to = tr.toLabel.toLowerCase();
      let hit = ex.filter(e => String(e.name).toLowerCase() === 'transit to ' + to);
      if(!hit.length) hit = ex.filter(e => String(e.name).toLowerCase().includes(to));
      if(hit.length) o.pts[tr.from] = hit.map(e => ({ x:e.p.x, y:e.p.y || 0, z:e.p.z }));
    }));
  }
  { const _an = analyze;
    analyze = function(){ resolveTransits(); return _an.apply(this, arguments); }; }

  /* the transit is always the last stop; the extract step is not needed because the transit is the way out */
  { const _br = buildRoute;
    buildRoute = function(a){
      const isT = g => g.o && g.o.transit;
      const tg = a.groups.filter(isT), rest = a.groups.filter(g => !isT(g));
      if(!tg.length) return _br(a);
      const r = rest.length ? _br(Object.assign({}, a, { groups:rest })) : { stops:[], len:0, exit:null };
      const left = tg.slice();
      while(left.length){
        const last = r.stops.length ? r.stops[r.stops.length - 1].p : null;
        let bi = 0, bp = null, bd = Infinity;
        left.forEach((g, i) => g.pts.forEach(p => { const d = last ? dist(last, p) : 0; if(d < bd){ bd = d; bi = i; bp = p; } }));
        const g = left.splice(bi, 1)[0];
        const prev = r.stops[r.stops.length - 1];
        if(prev && prev.transit && dist(prev.p, bp) < 25){ prev.items.push({ g, p:bp }); continue; }   /* two quests, same transit */
        if(last) r.len += bd;
        r.stops.push({ p:bp, items:[{ g, p:bp }], transit:true });
      }
      r.exit = null;
      return r;
    }; }

  /* under a transit step: what the quest still needs on the map you arrive at */
  function addContinuation(){
    const an = S.an, k = S.curMap, a = an && k && an.A[k];
    if(!a || !a.route) return;
    document.querySelectorAll('#route .steps li[data-i]').forEach(li => {
      const stop = a.route.stops[+li.dataset.i]; if(!stop || !stop.transit) return;
      li.querySelectorAll('.it').forEach((el, j) => {
        const it = stop.items[j], o = it && it.g.o, t = it && it.g.t; if(!o || !o.transit || el.querySelector('.cont')) return;
        const to = o.transit.to;
        const next = t.objs.filter(x => x !== o && x.maps.has(to) && !x.transit && !S.done.has(x.id) && (S.opts.optional || !x.optional));
        el.insertAdjacentHTML('beforeend', '<div class="cont"><b>Then on ' + esc(MAP_LABEL[to] || to) + (/one raid|single raid/i.test(o.desc) ? ' (same raid)' : '') + ':</b> ' +
          (next.length ? next.map(x => esc(x.desc)).join(' · ') : 'nothing more for this quest') + '</div>');
      });
    });
  }
  { const _rr = renderRoute;
    renderRoute = function(){ _rr(); addContinuation(); }; }
})();

/* ============ same-raid quests: show the full quest ============ */
(function wireRaidQuests(){
  const st = document.createElement('style');
  st.textContent = `
.oneraid .oq{margin:8px 0 4px}
.oneraid .oq-n{display:flex;align-items:center;gap:6px;font-weight:600}
.oneraid ol{margin:3px 0 0;padding-left:22px;font-size:13px;line-height:1.35}
.oneraid li{margin:2px 0}
.oneraid li.here{font-weight:600}
.oneraid li.done{opacity:.5;text-decoration:line-through;font-weight:400}
`;
  document.head.appendChild(st);

  const ONE = /\b(one|single) raid\b/i;
  const visible = (t, o) => S.opts.optional || !o.optional || S.done.has(o.id);
  const pretty = m => MAP_LABEL[m] || String(m).split('-').map(w => w ? w[0].toUpperCase() + w.slice(1) : w).join(' ');

  function addRaidQuests(){
    const box = $('#route'), an = S.an, k = S.curMap, a = an && k && an.A[k];
    if(!box || !a) return;
    const old = box.querySelector('.oneraid'); if(old) old.remove();
    /* quests with a remaining one-raid objective that still have something to do on this map */
    const qs = an.act.filter(t => (a.full.has(t.id) || a.part.has(t.id)) &&
      t.objs.some(o => (ONE.test(o.desc) || o.transit) && !S.done.has(o.id) && visible(t, o)));
    if(!qs.length) return;
    const html = '<div class="listbox oneraid"><h3>Same-raid quests \u2014 full list</h3>' +
      '<div class="muted">These quests continue on another map (or must be finished in one raid). ' +
      'Everything each quest needs is listed in order, including the parts on other maps.</div>' +
      qs.map(t => '<div class="oq"><div class="oq-n"><span class="swatch" style="display:inline-block;background:' + qColor(t) + '"></span>' + esc(t.name) + '</div><ol>' +
        t.objs.filter(o => visible(t, o)).map(o => {
          const where = o.transit ? pretty(o.transit.from) + ' \u2192 ' + pretty(o.transit.to) : [...o.maps].map(pretty).join(', ');
          return '<li class="' + (o.maps.has(k) ? 'here' : '') + ' ' + (S.done.has(o.id) ? 'done' : '') + '">' + esc(o.desc) +
            (where ? ' <span class="tag">' + esc(where) + '</span>' : '') + (o.optional ? ' <span class="tag opt">optional</span>' : '') + '</li>';
        }).join('') + '</ol></div>').join('') + '</div>';
    const first = box.querySelector('.listbox');
    if(first) first.insertAdjacentHTML('beforebegin', html); else box.insertAdjacentHTML('beforeend', html);
  }
  { const _rr = renderRoute;
    renderRoute = function(){ _rr(); addRaidQuests(); }; }

  /* click a pin: the popup lists the WHOLE quest in order, so a transit or other-map step cannot be missed */
  const st2 = document.createElement('style');
  st2.textContent = `
.fullq{margin:6px 0 2px;padding:5px 7px;border-left:3px solid #b57be0;background:rgba(181,123,224,.10);font-size:12px;line-height:1.3}
.fullq .fq-h{font-weight:600;margin-bottom:2px}
.fullq ol{margin:2px 0 0;padding-left:18px}
.fullq li{margin:2px 0}
.fullq li.here{font-weight:600}
.fullq li.done{opacity:.5;text-decoration:line-through;font-weight:400}
.fullq .tag{margin-left:4px}
`;
  document.head.appendChild(st2);
  function fullQuestHTML(t, cur){
    if(!t.objs.some(o => (ONE.test(o.desc) || o.transit) && !S.done.has(o.id) && visible(t, o))) return '';
    return '<div class="fullq"><div class="fq-h">Full quest — do in this order' + (t.objs.some(o => ONE.test(o.desc)) ? ' (some steps must be in one raid)' : '') + '</div><ol>' +
      t.objs.filter(o => visible(t, o)).map(o => {
        const where = o.transit ? pretty(o.transit.from) + ' → ' + pretty(o.transit.to) : [...o.maps].map(pretty).join(', ');
        return '<li class="' + (o === cur ? 'here' : '') + ' ' + (S.done.has(o.id) ? 'done' : '') + '">' + esc(o.desc) +
          (where ? ' <span class="tag">' + esc(where) + '</span>' : '') + (o === cur ? ' <span class="tag">this pin</span>' : '') + '</li>';
      }).join('') + '</ol></div>';
  }
  { const _pf = popupFor;
    popupFor = function(items, extra){
      const el = _pf(items, extra);
      const rows = el.querySelectorAll('.pi'), seen = new Set();
      items.forEach((it, i) => {
        if(!rows[i] || seen.has(it.t.id)) return;
        const h = fullQuestHTML(it.t, it.o); if(!h) return;
        seen.add(it.t.id);
        const b = rows[i].querySelector('button');
        if(b) b.insertAdjacentHTML('beforebegin', h); else rows[i].insertAdjacentHTML('beforeend', h);
      });
      return el;
    }; }
})();

/* ============ wiring ============ */
$('#q').addEventListener('input', updateSugg);
$('#q').addEventListener('keydown', e => {
  const ul = $('#sugg');
  if(e.key === 'ArrowDown' || e.key === 'ArrowUp'){
    e.preventDefault(); if(ul.hidden || !suggList.length) return;
    suggIdx = (suggIdx + (e.key === 'ArrowDown' ? 1 : -1) + suggList.length) % suggList.length;
    ul.querySelectorAll('li').forEach((li,i) => li.classList.toggle('sel', i === suggIdx));
  } else if(e.key === 'Enter'){ e.preventDefault(); pickSugg(suggIdx); }
  else if(e.key === 'Escape'){ ul.hidden = true; }
});
$('#sugg').addEventListener('mousedown', e => { const li = e.target.closest('li[data-i]'); if(li){ e.preventDefault(); pickSugg(+li.dataset.i); } });
$('#q').addEventListener('blur', () => setTimeout(() => $('#sugg').hidden = true, 120));
$('#clearAll').addEventListener('click', () => { if(S.active.size && confirm('Remove all active quests?')){ S.active.clear(); S.done.clear(); saveActive(); refresh(); } });
$('#optOptional').addEventListener('change', e => { S.opts.optional = e.target.checked; saveOpts(); refresh(); });
$('#optExt').addEventListener('change', e => { S.opts.extracts = e.target.checked; saveOpts(); if(S.map) drawOverlay(); });
$('#optFac').addEventListener('change', e => { S.opts.faction = e.target.value; saveOpts(); refresh(); });
$('#fit').addEventListener('click', () => {
  const a = S.an && S.an.A[S.curMap]; if(!S.map || !a || !a.route) return;
  const pts = a.route.stops.map(s => [s.p.z, s.p.x]); if(a.route.exit) pts.push([a.route.exit.e.p.z, a.route.exit.e.p.x]);
  S.map.fitBounds(L.latLngBounds(pts).pad(0.25), { maxZoom: S.fitZoom + 3 });
});
$('#bulk').addEventListener('click', () => { $('#bulkOut').textContent = ''; $('#bulkDlg').showModal(); $('#bulkTxt').focus(); });
$('#bulkCancel').addEventListener('click', () => $('#bulkDlg').close());
$('#bulkGo').addEventListener('click', () => {
  const lines = $('#bulkTxt').value.split(/\n/).map(s => s.trim()).filter(Boolean);
  const miss = []; let n = 0;
  lines.forEach(l => { const t = matchTask(l); if(t){ if(!S.active.has(t.id)){ S.active.add(t.id); n++; } } else miss.push(l); });
  saveActive(); refresh();
  if(miss.length){ $('#bulkTxt').value = miss.join('\n'); $('#bulkOut').textContent = `Added ${n}. Could not match ${miss.length} line${miss.length===1?'':'s'} (left in the box so you can fix the spelling).`; }
  else { $('#bulkTxt').value = ''; $('#bulkDlg').close(); }
});
document.querySelectorAll('#modeSeg button').forEach(b => b.addEventListener('click', () => {
  if(b.dataset.m === S.mode) return;
  S.mode = b.dataset.m; LS.set('rr_mode', S.mode); S.active.clear(); S.done.clear(); saveActive();
  $('#overlay').classList.remove('hide'); $('#overlay').innerHTML = '<h2>Raid Route</h2><div id="ovtext" class="muted">Loading…</div>'; boot(false);
}));
$('#refresh').addEventListener('click', () => { $('#overlay').innerHTML = '<h2>Raid Route</h2><div id="ovtext" class="muted">Loading…</div>'; boot(true); });
const alter = fn => { const k = S.curMap, al = getAl(k); fn(al); S.align[k] = al; LS.set('rr_align', S.align); openMap(k); };
$('#alRot').addEventListener('click', () => alter(al => al.k = (al.k + 1) % 4));
$('#alMir').addEventListener('click', () => alter(al => al.m = !al.m));
$('#alSwap').addEventListener('click', () => alter(al => { const cur = al.swap || detectBoundsMode(S.curMap, S.cal[S.curMap]); al.swap = cur === 'zx' ? 'xz' : 'zx'; }));
$('#alReset').addEventListener('click', () => { delete S.align[S.curMap]; LS.set('rr_align', S.align); openMap(S.curMap); });

if(typeof L === 'undefined'){
  showOvError(new Error('The map library (Leaflet) could not be loaded from cdnjs.cloudflare.com. Check your internet connection and reload the page.'));
} else boot(false);
</script>
</body>
</html>
